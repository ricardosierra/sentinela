{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ],
    "defaultMode": "bypassPermissions",
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sierra/.asdf/installs/python/3.13.0/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sierra/.asdf/installs/python/3.13.0/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  }
}
