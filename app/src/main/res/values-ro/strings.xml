    <string name="dialer_revert_cta">Alege alt telefon</string>
    <string name="dialer_revert_hint">Când revii la altă aplicație de telefon, modul filtru al Sentinela funcționează normal în continuare — fără reinstalare și fără reconfigurare.</string>

