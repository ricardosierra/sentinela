    <!-- Configurare: rolul de filtrare a apelurilor -->
    <string name="onboarding_role_disclaimer">La configurare, acorzi permisiunea de Call Screening. Sentinela va filtra apelurile de la numere din afara contactelor local, fără a trimite date de pe dispozitiv.</string>
