    <!-- Configurare: contacte -->
    <string name="contacts_title">Și persoanele din lista ta de contacte?</string>
    <string name="contacts_explainer">Stabilește cum trebuie să trateze Sentinela apelurile de la cei pe care îi cunoști deja. Poți schimba asta mai târziu.</string>
    <string name="contacts_permission_rationale" formatted="false">Ca să știe dacă apelantul este în agenda ta, Sentinela trebuie să îți citească contactele. Spre deosebire de alte aplicații, nu îți colectăm agenda. Citirea este 100% locală: datele nu părăsesc niciodată dispozitivul.</string>
    <string name="contacts_option_ring">Sună</string>
    <string name="contacts_option_ring_desc">Apelurile sună normal pe telefonul tău.</string>
    <string name="contacts_option_block">Blochează</string>
    <string name="contacts_option_block_desc">Blochează toate apelurile, conform modului de blocare din Protecție.</string>
    <string name="contacts_option_silence">Amuțește</string>
    <string name="contacts_option_silence_desc">Telefonul nu vibrează și nu sună, dar afișează notificarea.</string>
    <string name="contacts_option_never_silence">Nu amuți niciodată</string>
    <string name="contacts_option_never_silence_desc">Sentinela nu îți amuțește niciodată lista de contacte. Modul „Nu deranja” al sistemului rămâne valabil.</string>
    <string name="contacts_default_badge">Implicit</string>

    <string name="whatsapp_contacts_warning_title">Atenție la WhatsApp</string>
    <string name="whatsapp_contacts_warning_desc">WhatsApp permite salvarea contactelor doar în cloudul său. Persoanele salvate astfel nu există în agenda dispozitivului și vor fi tratate de Sentinela ca \"În afara contactelor\". Salvează-ți contactele în agenda oficială pentru ca blocatorul să le recunoască.</string>
    <string name="whatsapp_history_hint">Sfat: dacă este un contact WhatsApp nesalvat în agendă, folosește opțiunea de mai sus pentru a-l permite.</string>

    <string name="contacts_permission_granted">Citirea contactelor a fost acordată</string>
    <string name="contacts_permission_denied">Fără acces la agendă, Sentinela nu poate ști cine este în contactele tale: aceste apeluri pot fi tratate ca numere din afara contactelor.</string>
    <string name="contacts_permission_blocked">Citirea contactelor a fost refuzată definitiv. Ca să o acorzi, deschide setările aplicației.</string>
    <string name="settings_block_private_desc">Apelurile fără identificarea numărului urmează politica de blocare pe care ai ales-o. Nu se poate ști cine a sunat.</string>

