    <!-- Activarea modului apelare -->
    <string name="dialer_activation_title">Faci din Sentinela telefonul tău implicit?</string>
    <string name="dialer_activation_intro">În modul apelare, Sentinela primește toate apelurile — inclusiv de la cei din agenda ta. Este singurul mod în care politicile pe sursă se aplică și contactelor tale.</string>
    <string name="dialer_activation_changes_title">Ce se schimbă</string>
    <string name="dialer_activation_change_1">Sentinela devine aplicația ta de telefon: ecranul de apel și tastatura devin ale ei.</string>
    <string name="dialer_activation_change_2">Filtrarea începe să vadă toate apelurile, nu doar pe cele de la numere din afara agendei.</string>
    <string name="dialer_activation_change_3">Politica pe care ai ales-o pentru contacte se aplică cu adevărat. Valoarea implicită rămâne Sună — activarea modului apelare, singură, nu blochează pe nimeni.</string>
    <string name="dialer_activation_unchanged_title">Ce nu se schimbă</string>
    <string name="dialer_activation_unchanged_1">Apelurile continuă să fie înregistrate în istoricul telefonului. Faptul de a fi aplicația de telefon implicită nu îi dă Sentinela permisiunea de a omite acea înregistrare — pe Android, doar aplicațiile operatorilor pot.</string>
    <string name="dialer_activation_unchanged_2">Modul „Nu deranja” al sistemului rămâne prioritar față de setările Sentinela.</string>
    <string name="dialer_activation_unchanged_3">Apelurile din WhatsApp, Telegram și alte aplicații de internet rămân în afara razei de acțiune a Sentinela.</string>
    <string name="dialer_activation_unchanged_4" formatted="false">Sentinela rămâne 100% offline: niciun apel, număr sau contact nu părăsește dispozitivul.</string>
    <string name="dialer_activation_limit_calls">Un apel pe rând: apelul în așteptare și conferința nu sunt acceptate în această versiune.</string>
    <string name="dialer_activation_contacts_required">Modul apelare necesită permisiunea de citire a agendei. Fără ea, Sentinela nu poate distinge contactele tale și i-ar trata pe toți ca fiind în afara contactelor.</string>
    <string name="dialer_activation_grant_contacts">Permite citirea contactelor</string>
    <string name="dialer_activation_cta">Alege Sentinela</string>
    <string name="dialer_activation_cta_hint">Android decide. Poți reveni oricând.</string>

