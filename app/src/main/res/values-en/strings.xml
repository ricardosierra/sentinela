    <!-- Dialer mode activation -->
    <string name="dialer_activation_title">Make Sentinela your default phone app?</string>
    <string name="dialer_activation_intro">In dialer mode, Sentinela receives every call — including calls from people in your contacts. It is the only way for per-source policies to apply to your contacts too.</string>
    <string name="dialer_activation_changes_title">What changes</string>
    <string name="dialer_activation_change_1">Sentinela becomes your phone app: the call screen and the keypad become its own.</string>
    <string name="dialer_activation_change_2">Screening starts seeing every call, not only those from numbers outside your contacts.</string>
    <string name="dialer_activation_change_3">The policy you chose for contacts is actually applied. The default is still Ring — turning on dialer mode alone does not block anyone.</string>
    <string name="dialer_activation_unchanged_title">What does not change</string>
    <string name="dialer_activation_unchanged_1">Calls are still logged in the phone\'s call history. Being the default phone app does not give Sentinela permission to omit that record — on Android, only carrier apps can.</string>
    <string name="dialer_activation_unchanged_2">The system\'s \"Do Not Disturb\" still overrides Sentinela\'s settings.</string>
    <string name="dialer_activation_unchanged_3">Calls from WhatsApp, Telegram and other Internet apps remain out of Sentinela\'s reach.</string>
    <string name="dialer_activation_unchanged_4" formatted="false">Sentinela stays 100% offline: no call, number or contact leaves the device.</string>
    <string name="dialer_activation_limit_calls">One call at a time: call waiting and conference calls are not supported in this version.</string>
    <string name="dialer_activation_contacts_required">Dialer mode requires address book read permission. Without it, Sentinela cannot distinguish your contacts and would treat everyone as outside contacts.</string>
    <string name="dialer_activation_grant_contacts">Allow contacts access</string>
    <string name="dialer_activation_cta">Choose Sentinela</string>
    <string name="dialer_activation_cta_hint">Android is the one that decides. You can go back whenever you want.</string>

    <!-- Dialer mode already active -->
    <string name="dialer_active_chip">Active</string>
    <string name="dialer_active_title">Sentinela is your default phone app</string>
    <string name="action_back">Back</string>
    <string name="dialer_active_changes_title">What is in effect now</string>
    <string name="dialer_activation_unavailable">This device does not offer the default phone role — usually because it has no telephony. Sentinela\'s filter mode keeps working wherever there are phone calls.</string>
    <string name="dialer_revert_cta">Choose another phone app</string>
