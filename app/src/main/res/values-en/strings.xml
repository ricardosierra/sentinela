    <!-- Welcome -->
    <string name="welcome_headline">Your first line of defence against spam.</string>
    <string name="welcome_subtitle">Sentinela blocks calls from numbers outside your contacts before your phone even rings.</string>
    <string name="welcome_feature_local_title">Local blocking</string>
    <string name="welcome_feature_local_desc">Processed right on your device.</string>
    <string name="welcome_feature_silent_title">Silent</string>
    <string name="welcome_feature_silent_desc">No unwanted rings or vibrations.</string>
    <string name="welcome_feature_offline_title">No Internet</string>
    <string name="welcome_feature_offline_desc">Complete privacy. We don\'t collect your contacts.</string>
    <string name="welcome_badge_native">Native integration</string>
    <string name="welcome_cta">Start setup</string>
    <string name="welcome_cta_hint">Takes less than 2 minutes.</string>
    <string name="welcome_open_source" formatted="false">100% open source — no ads, no telemetry</string>

    <!-- Onboarding: call screening role -->
    <string name="onboarding_role_disclaimer">When setting up, you grant the Call Screening permission. Sentinela will filter calls from numbers outside your contacts locally, without ever sending your data off the device.</string>
    <string name="onboarding_role_cta">Set up now</string>
    <string name="onboarding_role_requesting">Requesting permission…</string>
    <string name="onboarding_step_indicator">Step %1$d of %2$d</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_back">Back</string>
    <string name="onboarding_finish">Finish setup</string>
    <string name="onboarding_change_later">You can change this setting at any time.</string>
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_role_title">Let Sentinela handle screening</string>
    <string name="onboarding_role_intro">To filter calls, Sentinela needs to be Android\'s default call screening app. You are the one who grants it, and you can undo it in the system settings whenever you want.</string>
    <string name="onboarding_role_denied">Sentinela did not get the call screening role. No call will be screened until you grant it — you can do that now or later, on the Protection screen.</string>
    <string name="onboarding_role_retry">Grant now</string>
    <string name="onboarding_scope_title">What Sentinela does not do</string>
    <string name="onboarding_scope_dnd">The system\'s \"Do Not Disturb\" still overrides Sentinela\'s settings.</string>

    <!-- Onboarding: unknown numbers -->
    <string name="unknown_title">Numbers Outside Contacts</string>
    <string name="unknown_question">How should Sentinela handle numbers that are not in your contacts?</string>
    <string name="unknown_option_block">Block</string>
    <string name="unknown_option_block_desc">Rejects the call instantly.</string>
    <string name="unknown_option_silence">Silence</string>
    <string name="unknown_option_silence_desc">The call comes through with no sound or vibration.</string>
    <string name="unknown_option_allow">Allow</string>
    <string name="unknown_option_allow_desc">Receives calls normally.</string>

    <!-- Onboarding: contacts -->
    <string name="contacts_title">What about the people in your contacts?</string>
    <string name="contacts_explainer">Choose how Sentinela should treat calls from people you already know. You can change this later.</string>
    <string name="contacts_permission_rationale" formatted="false">To know whether a caller is in your contacts, Sentinela needs to read them. Unlike other apps, we don\'t collect your contacts. Reading is 100% local: the data never leaves the device.</string>
    <string name="contacts_option_ring">Ring</string>
    <string name="contacts_option_ring_desc">Calls ring normally on your phone.</string>
    <string name="contacts_option_block">Block</string>
    <string name="contacts_option_block_desc">Blocks every call, following the blocking mode set in Protection.</string>
    <string name="contacts_option_silence">Silence</string>
    <string name="contacts_option_silence_desc">The phone neither vibrates nor rings, but shows the notification.</string>
    <string name="contacts_option_never_silence">Never silence</string>
    <string name="contacts_option_never_silence_desc">Sentinela never silences your contacts. The system\'s \"Do Not Disturb\" still applies.</string>
    <string name="contacts_default_badge">Default</string>

    <string name="whatsapp_contacts_warning_title">About WhatsApp</string>
    <string name="whatsapp_contacts_warning_desc">WhatsApp allows saving contacts only in its cloud. People saved that way do not exist in the device address book and, for Sentinela, will be treated as \"Outside contacts\". Save your contacts in the official address book so the blocker recognizes them.</string>
    <string name="whatsapp_history_hint">Tip: if this is a WhatsApp contact not saved in your address book, use the option above to allow it.</string>

    <string name="contacts_permission_granted">Contacts access granted</string>
    <string name="contacts_permission_denied">Without address book access, Sentinela cannot know who is in your contacts: those calls may be treated as numbers outside contacts.</string>
    <string name="contacts_permission_blocked">Contacts access was permanently denied. To grant it, open the app settings.</string>
    <string name="settings_block_private_desc">Calls with no caller ID follow the blocking policy you chose. There is no way to know who called.</string>

