    <string name="settings_mode_reject">Reject immediately</string>
    <string name="settings_mode_silent_voicemail">Forward silently</string>
    <string name="settings_hide_native_log">Ask not to log in the phone\'s call history</string>
    <string name="settings_hide_native_log_desc">Android only honours this request for carrier apps. Blocked calls still appear in the phone\'s call history, marked as blocked. What blocking does guarantee: no ring, no vibration, no call screen and no missed call notice.</string>
