    <string name="settings_privacy_title">Privacy</string>
    <string name="settings_privacy_disclaimer">Sentinela is 100% offline. Unlike other apps, we don\'t collect your contacts or send them to the cloud.</string>
    <string name="settings_mask_numbers">Mask incoming numbers</string>
    <string name="settings_mask_numbers_desc">Hides part of the numbers with asterisks (+55 11 9****-1234) in the history, notifications and home screen.</string>

    <string name="settings_protection_toggle_desc">When off, Sentinela does not block, does not silence and does not record anything. Calls follow the phone\'s normal behaviour.</string>
    <string name="settings_contacts_policy_note">This policy applies while contacts access is granted. Without it, contacts fall under the failure policy.</string>
    <string name="settings_block_mode_desc">Reject immediately gives the caller a busy signal. Forward silently sends the call to voicemail, if your carrier offers that service.</string>
    <string name="settings_repeated_call">Second call in a row rings</string>
    <string name="settings_repeated_call_desc">If the same number calls again a few minutes after being blocked, the second call rings. This is for emergencies from people not in your contacts.</string>
    <string name="settings_history_enabled">Keep blocking history</string>
    <string name="settings_history_enabled_desc">The history stays on this device only and is what lets you audit what Sentinela blocked. Turning it off does not erase what was already saved.</string>
    <string name="settings_history_off_kept">History off. The records already saved stay on the device.</string>
    <string name="settings_retention_title">Keep records for</string>
    <string name="settings_retention_never">Do not keep</string>
    <string name="settings_retention_7">7 days</string>
    <string name="settings_retention_30">30 days</string>
    <string name="settings_retention_90">90 days</string>
    <string name="settings_retention_manual">Until I delete them</string>
    <string name="settings_retention_never_confirm">Choosing \"Do not keep\" erases the existing records and Sentinela stops logging new blocks. This cannot be undone.</string>
    <plurals name="settings_clear_history_confirm">
        <item quantity="one">This erases %1$d blocked call record from this device. This cannot be undone.</item>
        <item quantity="other">This erases %1$d blocked call records from this device. This cannot be undone.</item>
    </plurals>
    <string name="settings_fallback_desc">If the local lookup fails, Sentinela has to decide on its own. Allowing risks letting an unwanted call through; blocking risks missing a call you wanted.</string>

