    <!-- Introduktion: kontakter -->
    <string name="contacts_title">Och personerna i din kontaktlista?</string>
    <string name="contacts_explainer">Bestäm hur Sentinela ska hantera samtal från dem du redan känner. Du kan ändra det senare.</string>
    <string name="contacts_permission_rationale" formatted="false">För att veta om den som ringer finns i din adressbok måste Sentinela läsa dina kontakter. Till skillnad från andra appar samlar vi inte in dina kontakter. Läsningen är 100% lokal: uppgifterna lämnar aldrig enheten.</string>
    <string name="contacts_option_ring">Ring</string>
    <string name="contacts_option_ring_desc">Samtalen ringer som vanligt i din telefon.</string>
    <string name="contacts_option_block">Blockera</string>
    <string name="contacts_option_block_desc">Blockerar alla samtal enligt blockeringsläget under Skydd.</string>
    <string name="contacts_option_silence">Tysta</string>
    <string name="contacts_option_silence_desc">Telefonen varken vibrerar eller ringer, men visar aviseringen.</string>
    <string name="contacts_option_never_silence">Tysta aldrig</string>
    <string name="contacts_option_never_silence_desc">Sentinela tystar aldrig din kontaktlista. Systemets \"Stör ej\" gäller fortfarande.</string>
    <string name="contacts_default_badge">Standard</string>

    <string name="whatsapp_contacts_warning_title">Om WhatsApp</string>
    <string name="whatsapp_contacts_warning_desc">WhatsApp låter dig spara kontakter enbart i sitt eget moln. Personer som sparats så finns inte i enhetens adressbok och behandlas av Sentinela som \"Okänd\". Spara dina kontakter i den officiella adressboken så att blockeraren känner igen dem.</string>
    <string name="whatsapp_history_hint">Tips: om det är en WhatsApp-kontakt som inte är sparad i adressboken kan du använda alternativet ovan för att tillåta den.</string>

    <string name="contacts_permission_granted">Åtkomst till kontakter beviljad</string>
    <string name="contacts_permission_denied">Utan åtkomst till kontakter kan Sentinela inte veta vem som finns i din adressbok: de samtalen kan behandlas som okända.</string>
    <string name="contacts_permission_blocked">Åtkomsten till kontakter nekades permanent. Öppna appens inställningar för att bevilja den.</string>
    <string name="settings_block_private_desc">Samtal utan nummerpresentation följer den blockeringspolicy du valt. Det går inte att veta vem som ringde.</string>

