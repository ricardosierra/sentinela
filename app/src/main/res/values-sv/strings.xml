    <string name="settings_privacy_title">Integritet</string>
    <string name="settings_privacy_disclaimer">Sentinela är 100% offline. Till skillnad från andra appar samlar vi inte in dina kontakter och skickar dem inte till molnet.</string>
    <string name="settings_mask_numbers">Maskera inkommande nummer</string>
    <string name="settings_mask_numbers_desc">Döljer en del av numren med asterisker (+55 11 9****-1234) i historiken, i aviseringar och på startskärmen.</string>

    <string name="settings_protection_toggle_desc">Avstängt blockerar Sentinela inte, tystar inte och registrerar ingenting. Samtalen följer telefonens normala beteende.</string>
    <string name="settings_contacts_policy_note">Den här policyn gäller så länge åtkomsten till kontakter är beviljad. Utan den hamnar kontakter under felpolicyn.</string>
    <string name="settings_block_mode_desc">Avvisa direkt ger upptagetton till den som ringer. Vidarekoppla tyst skickar samtalet till röstbrevlådan, om din operatör har den tjänsten.</string>
    <string name="settings_repeated_call">Andra samtalet i rad ringer</string>
    <string name="settings_repeated_call_desc">Om samma nummer ringer igen några minuter efter att ha blivit blockerat, ringer det andra samtalet. Det är till för nödsituationer från personer som inte finns i din adressbok.</string>
    <string name="settings_history_enabled">Spara blockeringshistorik</string>
    <string name="settings_history_enabled_desc">Historiken stannar bara på den här enheten och är det som gör det möjligt att granska vad Sentinela har blockerat. Att stänga av den raderar inte det som redan sparats.</string>
    <string name="settings_history_off_kept">Historiken avstängd. De poster som redan sparats finns kvar på enheten.</string>
    <string name="settings_retention_title">Spara poster i</string>
    <string name="settings_retention_never">Spara inte</string>
    <string name="settings_retention_7">7 dagar</string>
    <string name="settings_retention_30">30 dagar</string>
    <string name="settings_retention_90">90 dagar</string>
    <string name="settings_retention_manual">Tills jag tar bort dem</string>
    <string name="settings_retention_never_confirm">Att välja \"Spara inte\" raderar de befintliga posterna och Sentinela slutar registrera nya blockeringar. Det går inte att ångra.</string>
    <plurals name="settings_clear_history_confirm">
        <item quantity="one">Det här raderar %1$d post om blockerat samtal från den här enheten. Det går inte att ångra.</item>
        <item quantity="other">Det här raderar %1$d poster om blockerade samtal från den här enheten. Det går inte att ångra.</item>
    </plurals>
