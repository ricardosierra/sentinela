    <string name="settings_block_private">Blocca numeri privati</string>
    <string name="settings_dialer_mode">Modalità telefono (avanzata)</string>
    <string name="settings_dialer_mode_desc">Rende Sentinela l\'app telefono predefinita per applicare le politiche anche ai contatti. Puoi tornare indietro in qualsiasi momento.</string>
    <string name="settings_mode_reject">Rifiuta subito</string>
    <string name="settings_mode_silent_voicemail">Inoltra in silenzio</string>
    <string name="settings_hide_native_log">Chiedi di non registrare nel registro chiamate</string>
    <string name="settings_hide_native_log_desc">Android accoglie questa richiesta solo per le app degli operatori. Le chiamate bloccate continuano a comparire nel registro chiamate del telefono, contrassegnate come bloccate. Ciò che il blocco garantisce: non squilla, non vibra, non mostra la schermata di chiamata e non genera avvisi di chiamata persa.</string>
    <string name="settings_show_notification">Mostra notifica silenziosa</string>
    <string name="settings_fallback_policy">Cosa fare in caso di errore</string>
    <string name="settings_fallback_allow">Lascia squillare la chiamata</string>
    <string name="settings_fallback_block">Blocca</string>

    <string name="settings_privacy_title">Privacy</string>
    <string name="settings_privacy_disclaimer">Sentinela è 100% offline. A differenza di altre app, non raccogliamo i tuoi contatti né li inviamo al cloud.</string>
    <string name="settings_mask_numbers">Maschera i numeri in arrivo</string>
    <string name="settings_mask_numbers_desc">Nasconde parte dei numeri con asterischi (+55 11 9****-1234) nella cronologia, nelle notifiche e nella schermata iniziale.</string>

    <string name="settings_protection_toggle_desc">Disattivato, Sentinela non blocca, non silenzia e non registra nulla. Le chiamate seguono il normale comportamento del telefono.</string>
    <string name="settings_contacts_policy_note">Questa politica vale finché la lettura dei contatti è concessa. Senza di essa, i contatti ricadono nella politica di errore.</string>
    <string name="settings_block_mode_desc">Rifiuta subito dà il segnale di occupato a chi chiama. Inoltra in silenzio manda la chiamata alla segreteria telefonica, se il tuo operatore offre questo servizio.</string>
    <string name="settings_repeated_call">La seconda chiamata consecutiva squilla</string>
    <string name="settings_repeated_call_desc">Se lo stesso numero richiama pochi minuti dopo essere stato bloccato, la seconda chiamata squilla. Serve per le emergenze di chi non è nella tua rubrica.</string>
    <string name="settings_history_enabled">Conserva la cronologia dei blocchi</string>
    <string name="settings_history_enabled_desc">La cronologia resta solo su questo dispositivo ed è ciò che permette di verificare che cosa ha bloccato Sentinela. Disattivarla non cancella quanto è già stato salvato.</string>
    <string name="settings_history_off_kept">Cronologia disattivata. I record già salvati restano sul dispositivo.</string>
    <string name="settings_retention_title">Conserva i record per</string>
    <string name="settings_retention_never">Non conservare</string>
    <string name="settings_retention_7">7 giorni</string>
    <string name="settings_retention_30">30 giorni</string>
    <string name="settings_retention_90">90 giorni</string>
    <string name="settings_retention_manual">Finché non li elimino</string>
    <string name="settings_retention_never_confirm">Scegliere «Non conservare» cancella i record esistenti e Sentinela smette di registrare nuovi blocchi. L\'operazione non è annullabile.</string>
    <plurals name="settings_clear_history_confirm">
        <item quantity="one">Questo cancella %1$d record di chiamata bloccata da questo dispositivo. L\'operazione non è annullabile.</item>
        <item quantity="other">Questo cancella %1$d record di chiamate bloccate da questo dispositivo. L\'operazione non è annullabile.</item>
    </plurals>
    <string name="settings_fallback_desc">Se la ricerca locale non riesce, Sentinela deve decidere da solo. Consentire rischia di far passare una chiamata indesiderata; bloccare rischia di farti perdere una chiamata che volevi ricevere.</string>

