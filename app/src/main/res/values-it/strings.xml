    <!-- Avvio: contatti -->
    <string name="contacts_title">E le persone nella tua rubrica?</string>
    <string name="contacts_explainer">Scegli come Sentinela deve trattare le chiamate di chi già conosci. Puoi cambiarlo in seguito.</string>
    <string name="contacts_permission_rationale" formatted="false">Per sapere se chi chiama è nella tua rubrica, Sentinela deve leggere i tuoi contatti. A differenza di altre app, non raccogliamo i tuoi contatti. La lettura è 100% locale: i dati non escono mai dal dispositivo.</string>
    <string name="contacts_option_ring">Squilla</string>
    <string name="contacts_option_ring_desc">Le chiamate squillano normalmente sul tuo telefono.</string>
    <string name="contacts_option_block">Blocca</string>
    <string name="contacts_option_block_desc">Blocca tutte le chiamate, secondo la modalità di blocco impostata in Protezione.</string>
    <string name="contacts_option_silence">Silenzia</string>
    <string name="contacts_option_silence_desc">Il telefono non vibra e non squilla, ma mostra la notifica.</string>
    <string name="contacts_option_never_silence">Non silenziare mai</string>
    <string name="contacts_option_never_silence_desc">Sentinela non silenzia mai la tua rubrica. La modalità «Non disturbare» del sistema resta valida.</string>
    <string name="contacts_default_badge">Predefinito</string>

    <string name="whatsapp_contacts_warning_title">Avviso su WhatsApp</string>
    <string name="whatsapp_contacts_warning_desc">WhatsApp consente di salvare i contatti solo nel proprio cloud. Le persone salvate in questo modo non esistono nella rubrica del dispositivo e, per Sentinela, verranno trattate come \"Fuori dai contatti\". Salva i tuoi contatti nella rubrica ufficiale affinché il blocco li riconosca.</string>
    <string name="whatsapp_history_hint">Suggerimento: se si tratta di un contatto WhatsApp non salvato in rubrica, usa l\'opzione qui sopra per consentirlo.</string>

    <string name="contacts_permission_granted">Lettura dei contatti concessa</string>
    <string name="contacts_permission_denied">Senza l\'accesso alla rubrica, Sentinela non può sapere chi è nei tuoi contatti: tali chiamate potrebbero essere trattate come numeri fuori dai contatti.</string>
    <string name="contacts_permission_blocked">La lettura dei contatti è stata negata definitivamente. Per concederla, apri le impostazioni dell\'app.</string>
    <string name="settings_block_private_desc">Le chiamate senza identificativo seguono la politica di blocco che hai scelto. Non è possibile sapere chi ha chiamato.</string>

    <!-- Avvio: elenco personale -->
    <string name="whitelist_setup_title">Configurazione dell\'elenco personale</string>
    <string name="whitelist_setup_desc">L\'elenco personale è la tua lista di numeri fidati, separata dalla rubrica del telefono.</string>
    <string name="whitelist_setup_what_title">Che cos\'è l\'elenco personale?</string>
    <string name="whitelist_setup_what_desc">L\'elenco personale raccoglie i numeri che hai aggiunto manualmente o contrassegnato come sicuri nell\'app.</string>
    <string name="whitelist_setup_question">Come trattare il tuo elenco personale?</string>
    <string name="whitelist_option_never_silence">Non silenziare mai</string>
    <string name="whitelist_option_never_silence_desc">Sentinela non silenzia mai questa origine. La modalità «Non disturbare» del sistema resta valida.</string>
    <string name="whitelist_option_ring">Squilla</string>
    <string name="whitelist_option_ring_desc">Emetti sempre un suono.</string>
    <string name="whitelist_option_block">Blocca</string>
