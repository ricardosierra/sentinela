    <!-- Avvio: numeri sconosciuti -->
    <string name="unknown_title">Numeri fuori dai contatti</string>
    <string name="unknown_question">Come deve gestire Sentinela i numeri che non sono tra i tuoi contatti?</string>
    <string name="unknown_option_block">Blocca</string>
    <string name="unknown_option_block_desc">Rifiuta la chiamata all\'istante.</string>
