    <string name="whitelist_option_silence">Silenzia</string>
    <string name="whitelist_option_silence_desc">Solo notifica visiva.</string>
    <string name="whitelist_setup_hint">Potrai modificare queste impostazioni e aggiungere nuovi numeri in qualsiasi momento nel menu Consentiti.</string>

