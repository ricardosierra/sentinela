    <!-- Käyttöönotto: yhteystiedot -->
    <string name="contacts_title">Entä yhteystietoluettelosi henkilöt?</string>
    <string name="contacts_explainer">Määritä, miten Sentinelan tulee käsitellä jo tuntemiesi henkilöiden puheluita. Voit muuttaa tätä myöhemmin.</string>
    <string name="contacts_permission_rationale" formatted="false">Tietääkseen, onko soittaja yhteystiedoissasi, Sentinelan on luettava yhteystietosi. Toisin kuin muut sovellukset, emme kerää yhteystietojasi. Lukeminen on 100% paikallista: tiedot eivät koskaan poistu laitteesta.</string>
    <string name="contacts_option_ring">Soi</string>
    <string name="contacts_option_ring_desc">Puhelut soivat normaalisti puhelimessasi.</string>
    <string name="contacts_option_block">Estä</string>
    <string name="contacts_option_block_desc">Estää kaikki puhelut Suojaus-kohdassa valitun estotilan mukaisesti.</string>
    <string name="contacts_option_silence">Vaimenna</string>
    <string name="contacts_option_silence_desc">Puhelin ei värise eikä soi, mutta näyttää ilmoituksen.</string>
    <string name="contacts_option_never_silence">Älä vaimenna koskaan</string>
    <string name="contacts_option_never_silence_desc">Sentinela ei vaimenna koskaan yhteystietoluetteloasi. Järjestelmän Älä häiritse -tila on edelleen voimassa.</string>
    <string name="contacts_default_badge">Oletus</string>

    <string name="whatsapp_contacts_warning_title">Huomio WhatsAppista</string>
    <string name="whatsapp_contacts_warning_desc">WhatsApp sallii yhteystietojen tallentamisen vain omaan pilveensä. Näin tallennettuja henkilöitä ei ole laitteen yhteystiedoissa, ja Sentinela käsittelee heitä tuntemattomina. Tallenna yhteystietosi laitteen viralliseen luetteloon, jotta esto tunnistaa heidät.</string>
    <string name="whatsapp_history_hint">Vinkki: jos kyseessä on WhatsApp-yhteystieto, jota ei ole tallennettu laitteen luetteloon, salli se yllä olevalla valinnalla.</string>

    <string name="contacts_permission_granted">Yhteystietojen lukuoikeus myönnetty</string>
    <string name="contacts_permission_denied">Ilman yhteystietojen lukuoikeutta Sentinela ei voi tietää, kuka on yhteystiedoissasi: nämä puhelut voidaan käsitellä tuntemattomina.</string>
    <string name="contacts_permission_blocked">Yhteystietojen lukuoikeus evättiin pysyvästi. Myöntääksesi sen avaa sovelluksen asetukset.</string>
    <string name="settings_block_private_desc">Puhelut ilman numeronäyttöä noudattavat valitsemaasi estokäytäntöä. Ei ole mahdollista tietää, kuka soitti.</string>

