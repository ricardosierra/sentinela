    <!-- Uppsetning: tengiliðir -->
    <string name="contacts_title">En fólkið í tengiliðalistanum þínum?</string>
    <string name="contacts_explainer">Ákveddu hvernig Sentinela á að meðhöndla símtöl frá þeim sem þú þekkir nú þegar. Þú getur breytt þessu síðar.</string>
    <string name="contacts_permission_rationale" formatted="false">Til að vita hvort sá sem hringir sé í tengiliðunum þínum þarf Sentinela að lesa þá. Ólíkt öðrum forritum söfnum við ekki tengiliðunum þínum. Lesturinn er 100% staðbundinn: gögnin fara aldrei úr tækinu.</string>
    <string name="contacts_option_ring">Hringja</string>
    <string name="contacts_option_ring_desc">Símtöl hringja venjulega í símanum þínum.</string>
    <string name="contacts_option_block">Loka á</string>
    <string name="contacts_option_block_desc">Lokar á öll símtöl samkvæmt lokunarstillingunni undir Vernd.</string>
    <string name="contacts_option_silence">Þagga</string>
    <string name="contacts_option_silence_desc">Síminn hvorki titrar né hringir, en sýnir tilkynninguna.</string>
    <string name="contacts_option_never_silence">Aldrei þagga</string>
    <string name="contacts_option_never_silence_desc">Sentinela þaggar aldrei tengiliðalistann þinn. „Ónáðið ekki“ í kerfinu gildir áfram.</string>
    <string name="contacts_default_badge">Sjálfgefið</string>

    <string name="whatsapp_contacts_warning_title">Um WhatsApp</string>
    <string name="whatsapp_contacts_warning_desc">WhatsApp leyfir að vista tengiliði eingöngu í skýinu sínu. Fólk sem vistað er þannig er ekki í tengiliðaskrá tækisins og verður meðhöndlað af Sentinela sem \"Utan tengiliða\". Vistaðu tengiliði í opinberu tengiliðaskránni svo útilokunin þekki þá.</string>
    <string name="whatsapp_history_hint">Ábending: ef þetta er WhatsApp-tengiliður sem er ekki vistaður í tengiliðaskránni skaltu nota valkostinn hér að ofan til að leyfa hann.</string>

    <string name="contacts_permission_granted">Aðgangur að tengiliðum veittur</string>
    <string name="contacts_permission_denied">Án aðgangs að tengiliðaskrá getur Sentinela ekki vitað hver er í tengiliðunum þínum: þessi símtöl gætu verið meðhöndluð sem númer utan tengiliða.</string>
    <string name="contacts_permission_blocked">Aðgangi að tengiliðum var hafnað varanlega. Opnaðu stillingar forritsins til að veita hann.</string>
    <string name="settings_block_private_desc">Símtöl án númerabirtingar fylgja lokunarreglunni sem þú valdir. Ekki er hægt að vita hver hringdi.</string>

