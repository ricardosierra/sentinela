    <string name="settings_privacy_title">Friðhelgi</string>
    <string name="settings_privacy_disclaimer">Sentinela er 100% án nettengingar. Ólíkt öðrum forritum söfnum við ekki tengiliðunum þínum og sendum þá ekki í skýið.</string>
    <string name="settings_mask_numbers">Hylja númer sem hringja inn</string>
    <string name="settings_mask_numbers_desc">Felur hluta númeranna með stjörnum (+55 11 9****-1234) í sögunni, í tilkynningum og á heimaskjánum.</string>

    <string name="settings_protection_toggle_desc">Slökkt lokar Sentinela ekki, þaggar ekki og skráir ekkert. Símtölin fylgja venjulegri hegðun símans.</string>
    <string name="settings_contacts_policy_note">Þessi regla gildir á meðan aðgangur að tengiliðum er veittur. Án hans falla tengiliðir undir villuregluna.</string>
    <string name="settings_block_mode_desc">Hafna strax gefur þeim sem hringir upptekið merki. Áframsenda hljóðlaust sendir símtalið í talhólfið, ef símafyrirtækið þitt býður þá þjónustu.</string>
    <string name="settings_repeated_call">Annað símtal í röð hringir</string>
    <string name="settings_repeated_call_desc">Ef sama númer hringir aftur fáeinum mínútum eftir að hafa verið lokað hringir annað símtalið. Það er fyrir neyðartilvik frá fólki sem er ekki í tengiliðunum þínum.</string>
    <string name="settings_history_enabled">Geyma lokunarsögu</string>
    <string name="settings_history_enabled_desc">Sagan helst aðeins í þessu tæki og er það sem gerir kleift að sannreyna hvað Sentinela hefur lokað á. Að slökkva á henni eyðir ekki því sem þegar var vistað.</string>
    <string name="settings_history_off_kept">Sagan er óvirk. Þær færslur sem þegar voru vistaðar haldast í tækinu.</string>
    <string name="settings_retention_title">Geyma færslur í</string>
    <string name="settings_retention_never">Ekki geyma</string>
    <string name="settings_retention_7">7 daga</string>
    <string name="settings_retention_30">30 daga</string>
    <string name="settings_retention_90">90 daga</string>
    <string name="settings_retention_manual">Þar til ég eyði þeim</string>
    <string name="settings_retention_never_confirm">Að velja „Ekki geyma“ eyðir núverandi færslum og Sentinela hættir að skrá nýjar lokanir. Þetta er ekki hægt að afturkalla.</string>
    <plurals name="settings_clear_history_confirm">
        <item quantity="one">Þetta eyðir %1$d færslu um lokað símtal úr þessu tæki. Þetta er ekki hægt að afturkalla.</item>
        <item quantity="other">Þetta eyðir %1$d færslum um lokuð símtöl úr þessu tæki. Þetta er ekki hægt að afturkalla.</item>
    </plurals>
    <string name="settings_fallback_desc">Ef staðbundna uppflettingin mistekst verður Sentinela að ákveða sjálft. Að leyfa á á hættu að hleypa óæskilegu símtali í gegn; að loka á á á hættu að þú missir af símtali sem þú vildir fá.</string>

