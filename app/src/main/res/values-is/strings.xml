    <!-- Virkjun símtalsstillingar -->
    <string name="dialer_activation_title">Á Sentinela að verða sjálfgefni síminn þinn?</string>
    <string name="dialer_activation_intro">Í símtalsstillingu tekur Sentinela við öllum símtölum — líka frá þeim sem eru í tengiliðunum þínum. Það er eina leiðin til að reglurnar eftir uppruna gildi líka um tengiliðina þína.</string>
    <string name="dialer_activation_changes_title">Hvað breytist</string>
    <string name="dialer_activation_change_1">Sentinela verður símaforritið þitt: símtalsskjárinn og talnaborðið verða þess eigin.</string>
    <string name="dialer_activation_change_2">Síunin fer að sjá öll símtöl, ekki aðeins þau frá númerum utan tengiliðaskrárinnar.</string>
    <string name="dialer_activation_change_3">Reglan sem þú valdir fyrir tengiliði er raunverulega notuð. Sjálfgefið er áfram Hringja — að kveikja á símtalsstillingu lokar ekki eitt og sér á neinn.</string>
    <string name="dialer_activation_unchanged_title">Hvað breytist ekki</string>
    <string name="dialer_activation_unchanged_1">Símtöl eru áfram skráð í símtalaskrá símans. Að vera sjálfgefna símaforritið veitir Sentinela ekki heimild til að sleppa þeirri skráningu — í Android geta aðeins forrit símafyrirtækja það.</string>
    <string name="dialer_activation_unchanged_2">„Ónáðið ekki“ í kerfinu gildir áfram framar stillingum Sentinela.</string>
    <string name="dialer_activation_unchanged_3">Símtöl frá WhatsApp, Telegram og öðrum netforritum eru áfram utan seilingar Sentinela.</string>
    <string name="dialer_activation_unchanged_4" formatted="false">Sentinela helst 100% án nettengingar: ekkert símtal, númer eða tengiliður fer úr tækinu.</string>
    <string name="dialer_activation_limit_calls">Eitt símtal í einu: símtal í bið og símafundur eru ekki studd í þessari útgáfu.</string>
    <string name="dialer_activation_contacts_required">Hringistilling krefst leyfis til að lesa tengiliðaskrá. Án þess getur Sentinela ekki greint tengiliðina þína og myndi meðhöndla alla sem utan tengiliða.</string>
    <string name="dialer_activation_grant_contacts">Leyfa lestur tengiliða</string>
    <string name="dialer_activation_cta">Velja Sentinela</string>
    <string name="dialer_activation_cta_hint">Það er Android sem ræður. Þú getur snúið til baka hvenær sem er.</string>

