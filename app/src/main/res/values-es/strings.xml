    <!-- Onboarding: números desconocidos -->
    <string name="unknown_title">Llamadas desconocidas</string>
    <string name="unknown_question">¿Cómo debe tratar Sentinela los números que no están en tus contactos?</string>
    <string name="unknown_option_block">Bloquear</string>
