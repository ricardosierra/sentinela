    <string name="whitelist_setup_what_desc">La lista personal son los números que añadiste manualmente o marcaste como seguros dentro de la aplicación.</string>
    <string name="whitelist_setup_question">¿Cómo tratar tu lista personal?</string>
    <string name="whitelist_option_never_silence">Nunca silenciar</string>
    <string name="whitelist_option_never_silence_desc">Sentinela nunca silencia este origen. El \"No molestar\" del sistema sigue vigente.</string>
    <string name="whitelist_option_ring">Sonar</string>
    <string name="whitelist_option_ring_desc">Emitir sonido siempre.</string>
    <string name="whitelist_option_block">Bloquear</string>
