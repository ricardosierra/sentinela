    <!-- Onboarding: contactos -->
    <string name="contacts_title">¿Y las personas de tu lista de contactos?</string>
    <string name="contacts_explainer">Define cómo debe tratar Sentinela las llamadas de quienes ya conoces. Puedes cambiarlo después.</string>
    <string name="contacts_permission_rationale" formatted="false">Para saber si quien llama está en tu agenda, Sentinela necesita leer tus contactos. A diferencia de otras aplicaciones, no recopilamos tus contactos. La lectura es 100% local: los datos nunca salen del dispositivo.</string>
    <string name="contacts_option_ring">Sonar</string>
    <string name="contacts_option_ring_desc">Las llamadas suenan con normalidad en tu teléfono.</string>
    <string name="contacts_option_block">Bloquear</string>
    <string name="contacts_option_block_desc">Bloquea todas las llamadas, según el modo de bloqueo de Protección.</string>
    <string name="contacts_option_silence">Silenciar</string>
    <string name="contacts_option_silence_desc">El teléfono no vibra ni suena, pero muestra la notificación.</string>
    <string name="contacts_option_never_silence">Nunca silenciar</string>
    <string name="contacts_option_never_silence_desc">Sentinela nunca silencia tu lista de contactos. El \"No molestar\" del sistema sigue vigente.</string>
    <string name="contacts_default_badge">Predeterminado</string>

    <string name="whatsapp_contacts_warning_title">Aviso sobre WhatsApp</string>
    <string name="whatsapp_contacts_warning_desc">WhatsApp permite guardar contactos solo en su propia nube. Las personas guardadas así no existen en la agenda del dispositivo y, para Sentinela, se tratan como \"Desconocido\". Guarda tus contactos en la agenda oficial para que el bloqueador los reconozca.</string>
    <string name="whatsapp_history_hint">Consejo: si es un contacto de WhatsApp que no está guardado en la agenda, usa la opción de arriba para permitirlo.</string>

    <string name="contacts_permission_granted">Lectura de contactos concedida</string>
    <string name="contacts_permission_denied">Sin la lectura de contactos, Sentinela no puede saber quién está en tu agenda: esas llamadas pueden tratarse como desconocidas.</string>
    <string name="contacts_permission_blocked">La lectura de contactos se denegó de forma permanente. Para concederla, abre los ajustes de la aplicación.</string>
    <string name="settings_block_private_desc">Las llamadas sin identificación de número siguen la política de bloqueo que elegiste. No es posible saber quién llamó.</string>

