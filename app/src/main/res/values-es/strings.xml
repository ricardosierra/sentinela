    <!-- Onboarding: rol de filtrado de llamadas -->
    <string name="onboarding_role_disclaimer">Al configurarlo, concedes el permiso de filtrado de llamadas. Sentinela filtra las llamadas de números desconocidos de forma local, sin enviar nunca tus datos fuera del dispositivo.</string>
