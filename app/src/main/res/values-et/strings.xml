    <string name="contacts_title">Ja inimesed sinu kontaktiloendis?</string>
    <string name="contacts_explainer">Määra, kuidas Sentinela peaks käsitlema kõnesid neilt, keda juba tunned. Saad seda hiljem muuta.</string>
    <string name="contacts_permission_rationale" formatted="false">Et teada, kas helistaja on sinu kontaktides, peab Sentinela neid lugema. Erinevalt teistest rakendustest me sinu kontakte ei kogu. Lugemine on 100% kohalik: andmed ei lahku kunagi seadmest.</string>
    <string name="contacts_option_ring">Helise</string>
    <string name="contacts_option_ring_desc">Kõned helisevad sinu telefonis tavapäraselt.</string>
    <string name="contacts_option_block">Blokeeri</string>
    <string name="contacts_option_block_desc">Blokeerib kõik kõned vastavalt jaotises Kaitse valitud blokeerimisrežiimile.</string>
