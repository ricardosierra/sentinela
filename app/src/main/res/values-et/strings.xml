    <string name="contacts_option_never_silence_desc">Sentinela ei vaigista kunagi sinu kontaktiloendit. Süsteemi „Mitte segada“ kehtib endiselt.</string>
    <string name="contacts_default_badge">Vaikimisi</string>

    <string name="whatsapp_contacts_warning_title">Märkus WhatsAppi kohta</string>
    <string name="whatsapp_contacts_warning_desc">WhatsApp võimaldab kontakte salvestada ainult oma pilve. Sel viisil salvestatud inimesi pole seadme kontaktiloendis ja Sentinela käsitleb neid kui \"Väljaspool kontakte\". Salvesta kontaktid ametlikku kontaktiloendisse, et blokeerija need ära tunneks.</string>
    <string name="whatsapp_history_hint">Nõuanne: kui tegemist on WhatsAppi kontaktiga, mida ei ole kontaktiraamatusse salvestatud, kasuta selle lubamiseks ülalolevat valikut.</string>

    <string name="contacts_permission_granted">Kontaktide lugemise luba antud</string>
    <string name="contacts_permission_denied">Ilma juurdepääsuta kontaktiloendile ei tea Sentinela, kes on sinu kontaktides: neid kõnesid võidakse käsitleda kontaktideväliste numbritena.</string>
    <string name="contacts_permission_blocked">Kontaktide lugemine keelati lõplikult. Loa andmiseks ava rakenduse seaded.</string>
    <string name="settings_block_private_desc">Numbrikuvata kõned järgivad sinu valitud blokeerimisreeglit. Ei ole võimalik teada, kes helistas.</string>

