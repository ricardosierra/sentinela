    <!-- Onboarding: contacten -->
    <string name="contacts_title">En de mensen in je contactenlijst?</string>
    <string name="contacts_explainer">Bepaal hoe Sentinela oproepen moet behandelen van mensen die je al kent. Je kunt dit later wijzigen.</string>
    <string name="contacts_permission_rationale" formatted="false">Om te weten of de beller in je adresboek staat, moet Sentinela je contacten lezen. Anders dan andere apps verzamelen we je contacten niet. Het lezen gebeurt 100% lokaal: de gegevens verlaten het toestel nooit.</string>
    <string name="contacts_option_ring">Overgaan</string>
    <string name="contacts_option_ring_desc">Oproepen gaan normaal over op je telefoon.</string>
    <string name="contacts_option_block">Blokkeren</string>
    <string name="contacts_option_block_desc">Blokkeert alle oproepen, volgens de blokkeermodus in Beveiliging.</string>
    <string name="contacts_option_silence">Dempen</string>
    <string name="contacts_option_silence_desc">De telefoon trilt en rinkelt niet, maar toont de melding.</string>
    <string name="contacts_option_never_silence">Nooit dempen</string>
    <string name="contacts_option_never_silence_desc">Sentinela dempt je contactenlijst nooit. De stand \'Niet storen\' van het systeem blijft gelden.</string>
    <string name="contacts_default_badge">Standaard</string>

    <string name="whatsapp_contacts_warning_title">Let op bij WhatsApp</string>
    <string name="whatsapp_contacts_warning_desc">WhatsApp staat toe contacten alleen in de cloud op te slaan. Mensen die zo zijn opgeslagen bestaan niet in het adresboek van het apparaat en worden voor Sentinela behandeld als \"Buiten contacten\". Sla je contacten op in het officiële adresboek zodat de blokkering ze herkent.</string>
    <string name="whatsapp_history_hint">Tip: als dit een WhatsApp-contact is dat niet in het adresboek staat, gebruik dan de optie hierboven om het toe te staan.</string>

    <string name="contacts_permission_granted">Toegang tot contacten verleend</string>
    <string name="contacts_permission_denied">Zonder toegang tot het adresboek kan Sentinela niet weten wie er in je contacten staat: die oproepen kunnen worden behandeld als nummers buiten contacten.</string>
    <string name="contacts_permission_blocked">Toegang tot contacten is definitief geweigerd. Open de app-instellingen om die alsnog te geven.</string>
    <string name="settings_block_private_desc">Oproepen zonder nummerweergave volgen het blokkeerbeleid dat je hebt gekozen. Het is niet te achterhalen wie er belde.</string>

