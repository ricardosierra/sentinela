    <!-- Onboarding: rol voor oproepfiltering -->
    <string name="onboarding_role_disclaimer">Bij het instellen verleen je de toestemming voor Call Screening. Sentinela filtert oproepen van nummers buiten je contacten lokaal, zonder ooit je gegevens te verzenden.</string>
