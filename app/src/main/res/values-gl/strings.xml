    <!-- Configuración inicial: rol de filtrado de chamadas -->
    <string name="onboarding_role_disclaimer">Ao configuralo, concedes o permiso de filtrado de chamadas. Sentinela filtra as chamadas de números descoñecidos localmente, sen enviar nunca os teus datos fóra do dispositivo.</string>
    <string name="onboarding_role_cta">Configurar agora</string>
    <string name="onboarding_role_requesting">Solicitando permiso…</string>
    <string name="onboarding_step_indicator">Paso %1$d de %2$d</string>
    <string name="onboarding_next">Seguinte</string>
    <string name="onboarding_back">Atrás</string>
