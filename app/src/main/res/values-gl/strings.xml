    <!-- Configuración inicial: contactos -->
    <string name="contacts_title">E as persoas da túa lista de contactos?</string>
    <string name="contacts_explainer">Define como debe tratar Sentinela as chamadas de quen xa coñeces. Podes cambialo despois.</string>
    <string name="contacts_permission_rationale" formatted="false">Para saber se quen chama está na túa axenda, Sentinela precisa ler os teus contactos. A diferenza doutras aplicacións, non recollemos os teus contactos. A lectura é 100% local: os datos nunca saen do dispositivo.</string>
    <string name="contacts_option_ring">Soar</string>
    <string name="contacts_option_ring_desc">As chamadas soan con normalidade no teu teléfono.</string>
    <string name="contacts_option_block">Bloquear</string>
    <string name="contacts_option_block_desc">Bloquea todas as chamadas, segundo o modo de bloqueo en Protección.</string>
    <string name="contacts_option_silence">Silenciar</string>
    <string name="contacts_option_silence_desc">O teléfono non vibra nin soa, pero mostra a notificación.</string>
    <string name="contacts_option_never_silence">Non silenciar nunca</string>
    <string name="contacts_option_never_silence_desc">Sentinela nunca silencia a túa lista de contactos. O «Non molestar» do sistema segue vixente.</string>
    <string name="contacts_default_badge">Predeterminado</string>

    <string name="whatsapp_contacts_warning_title">Aviso sobre WhatsApp</string>
    <string name="whatsapp_contacts_warning_desc">WhatsApp permite gardar contactos só na súa propia nube. As persoas gardadas así non existen na axenda do dispositivo e, para Sentinela, trátanse como «Descoñecido». Garda os teus contactos na axenda oficial para que o bloqueador os recoñeza.</string>
    <string name="whatsapp_history_hint">Consello: se é un contacto de WhatsApp non gardado na axenda, usa a opción de arriba para permitilo.</string>

    <string name="contacts_permission_granted">Lectura de contactos concedida</string>
    <string name="contacts_permission_denied">Sen a lectura de contactos, Sentinela non pode saber quen está na túa axenda: esas chamadas poden tratarse como descoñecidas.</string>
    <string name="contacts_permission_blocked">A lectura de contactos denegouse definitivamente. Para concedela, abre a configuración da aplicación.</string>
    <string name="settings_block_private_desc">As chamadas sen identificación de número seguen a política de bloqueo que escolliches. Non é posible saber quen chamou.</string>

    <!-- Configuración inicial: lista persoal -->
    <string name="whitelist_setup_title">Configuración da lista persoal</string>
    <string name="whitelist_setup_desc">A lista persoal é a túa propia lista de números de confianza, separada da axenda do teléfono.</string>
    <string name="whitelist_setup_what_title">Que é a lista persoal?</string>
    <string name="whitelist_setup_what_desc">A lista persoal son os números que engadiches manualmente ou marcaches como seguros dentro da aplicación.</string>
    <string name="whitelist_setup_question">Como tratar a túa lista persoal?</string>
    <string name="whitelist_option_never_silence">Non silenciar nunca</string>
    <string name="whitelist_option_never_silence_desc">Sentinela nunca silencia esta orixe. O «Non molestar» do sistema segue vixente.</string>
    <string name="whitelist_option_ring">Soar</string>
    <string name="whitelist_option_ring_desc">Emitir sempre un son.</string>
    <string name="whitelist_option_block">Bloquear</string>
    <string name="whitelist_option_block_desc">Rexeitar automaticamente.</string>
    <string name="whitelist_option_silence">Silenciar</string>
    <string name="whitelist_option_silence_desc">Só notificación visual.</string>
    <string name="whitelist_setup_hint">Poderás cambiar esta configuración e engadir números novos en calquera momento no menú Permitidos.</string>

