    <!-- Configuración inicial: números descoñecidos -->
    <string name="unknown_title">Chamadas descoñecidas</string>
    <string name="unknown_question">Como debe tratar Sentinela os números que non están nos teus contactos?</string>
    <string name="unknown_option_block">Bloquear</string>
    <string name="unknown_option_block_desc">Rexeita a chamada ao instante.</string>
