    <string name="settings_privacy_title">Privacidade</string>
    <string name="settings_privacy_disclaimer">Sentinela é 100%% sen conexión. A diferenza doutras aplicacións, non recollemos os teus contactos nin os enviamos á nube.</string>
    <string name="settings_mask_numbers">Enmascarar os números entrantes</string>
    <string name="settings_mask_numbers_desc">Agocha parte dos números con asteriscos (+55 11 9****-1234) no historial, nas notificacións e na pantalla de inicio.</string>

    <string name="settings_protection_toggle_desc">Desactivado, Sentinela non bloquea, non silencia e non rexistra nada. As chamadas seguen o comportamento normal do teléfono.</string>
    <string name="settings_contacts_policy_note">Esta política vale mentres a lectura da axenda estea concedida. Sen ela, os contactos caen na política de erro.</string>
    <string name="settings_block_mode_desc">Rexeitar de inmediato dá sinal de ocupado a quen chama. Desviar en silencio manda a chamada ao buzón de voz, se a túa operadora ten ese servizo.</string>
    <string name="settings_repeated_call">A segunda chamada seguida soa</string>
    <string name="settings_repeated_call_desc">Se o mesmo número volve chamar poucos minutos despois de ser bloqueado, a segunda chamada soa. Serve para emerxencias de quen non está na túa axenda.</string>
    <string name="settings_history_enabled">Gardar o historial de bloqueos</string>
    <string name="settings_history_enabled_desc">O historial queda só neste dispositivo e é o que permite auditar o que Sentinela bloqueou. Desactivalo non borra o que xa se gardou.</string>
    <string name="settings_history_off_kept">Historial desactivado. Os rexistros xa gardados seguen no dispositivo.</string>
    <string name="settings_retention_title">Gardar rexistros durante</string>
    <string name="settings_retention_never">Non gardar</string>
    <string name="settings_retention_7">7 días</string>
    <string name="settings_retention_30">30 días</string>
    <string name="settings_retention_90">90 días</string>
    <string name="settings_retention_manual">Ata que os elimine</string>
    <string name="settings_retention_never_confirm">Escoller «Non gardar» borra os rexistros existentes e Sentinela deixa de rexistrar novos bloqueos. Non se pode desfacer.</string>
    <plurals name="settings_clear_history_confirm">
        <item quantity="one">Isto borra %1$d rexistro de chamada bloqueada deste dispositivo. Non se pode desfacer.</item>
        <item quantity="other">Isto borra %1$d rexistros de chamadas bloqueadas deste dispositivo. Non se pode desfacer.</item>
    </plurals>
    <string name="settings_fallback_desc">Se a consulta local falla, Sentinela ten que decidir só. Permitir arrisca deixar pasar unha chamada non desexada; bloquear arrisca perder unha chamada que querías recibir.</string>

