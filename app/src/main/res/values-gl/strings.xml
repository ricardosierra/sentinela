    <string name="settings_dialer_mode_desc">Converte Sentinela na aplicación de teléfono predeterminada para aplicar as políticas tamén aos contactos. Podes revertelo en calquera momento.</string>
    <string name="settings_mode_reject">Rexeitar de inmediato</string>
