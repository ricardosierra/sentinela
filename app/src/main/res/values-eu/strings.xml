    <!-- Konfigurazioa: kontaktuak -->
    <string name="contacts_title">Eta zure kontaktu-zerrendako pertsonak?</string>
    <string name="contacts_explainer">Zehaztu nola tratatu behar dituen Sentinela-k dagoeneko ezagutzen dituzunen deiak. Geroago alda dezakezu.</string>
    <string name="contacts_permission_rationale" formatted="false">Deitzen duena zure agendan dagoen jakiteko, Sentinela-k zure kontaktuak irakurri behar ditu. Beste aplikazio batzuek ez bezala, ez ditugu zure kontaktuak biltzen. Irakurketa % 100 lokala da: datuak ez dira inoiz gailutik ateratzen.</string>
    <string name="contacts_option_ring">Jo</string>
    <string name="contacts_option_ring_desc">Deiek normaltasunez jotzen dute zure telefonoan.</string>
    <string name="contacts_option_block">Blokeatu</string>
    <string name="contacts_option_block_desc">Dei guztiak blokeatzen ditu, Babesa ataleko blokeo-moduaren arabera.</string>
    <string name="contacts_option_silence">Isildu</string>
    <string name="contacts_option_silence_desc">Telefonoak ez du dardara egiten ez jotzen, baina jakinarazpena erakusten du.</string>
    <string name="contacts_option_never_silence">Ez isildu inoiz</string>
    <string name="contacts_option_never_silence_desc">Sentinela-k ez du inoiz zure kontaktu-zerrenda isiltzen. Sistemaren «Ez molestatu» moduak indarrean jarraitzen du.</string>
    <string name="contacts_default_badge">Lehenetsia</string>

    <string name="whatsapp_contacts_warning_title">WhatsApp-i buruzko oharra</string>
    <string name="whatsapp_contacts_warning_desc">WhatsAppek bere hodeian soilik gordetzeko aukera ematen du. Horrela gordetako pertsonak ez daude gailuaren agendan eta Sentinelak \"Kontaktuetatik kanpo\" gisa tratatuko ditu. Gorde kontaktuak agenda ofizialean blokeatzaileak ezagut ditzan.</string>
    <string name="whatsapp_history_hint">Aholkua: agendan gorde gabeko WhatsApp kontaktu bat bada, erabili goiko aukera baimentzeko.</string>

    <string name="contacts_permission_granted">Kontaktuak irakurtzeko baimena emanda</string>
    <string name="contacts_permission_denied">Agendarako sarbiderik gabe, Sentinelak ezin du jakin nor dagoen zure kontaktuetan: dei horiek kontaktuetatik kanpoko zenbaki gisa trata daitezke.</string>
    <string name="contacts_permission_blocked">Kontaktuak irakurtzeko baimena behin betiko ukatu da. Emateko, ireki aplikazioaren ezarpenak.</string>
    <string name="settings_block_private_desc">Zenbaki-identifikaziorik gabeko deiek zuk aukeratutako blokeo-politika jarraitzen dute. Ezin da jakin nork deitu duen.</string>

