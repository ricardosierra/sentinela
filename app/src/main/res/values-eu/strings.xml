    <string name="settings_privacy_title">Pribatutasuna</string>
    <string name="settings_privacy_disclaimer">Sentinela % 100 lineaz kanpokoa da. Beste aplikazio batzuek ez bezala, ez ditugu zure kontaktuak biltzen ez hodeira bidaltzen.</string>
    <string name="settings_mask_numbers">Maskaratu jasotako zenbakiak</string>
    <string name="settings_mask_numbers_desc">Zenbakien zati bat izartxoekin ezkutatzen du (+55 11 9****-1234) historian, jakinarazpenetan eta hasierako pantailan.</string>

    <string name="settings_protection_toggle_desc">Desaktibatuta, Sentinela-k ez du blokeatzen, ez du isiltzen eta ez du ezer erregistratzen. Deiek telefonoaren portaera normala jarraitzen dute.</string>
    <string name="settings_contacts_policy_note">Politika hau agenda irakurtzeko baimena emanda dagoen bitartean balio du. Hori gabe, kontaktuak errore-politikara erortzen dira.</string>
    <string name="settings_block_mode_desc">Berehala ukatzeak okupatuta seinalea ematen dio deitzen duenari. Isilean birbideratzeak deia ahots-postara bidaltzen du, zure operadoreak zerbitzu hori badu.</string>
    <string name="settings_repeated_call">Segidako bigarren deiak jotzen du</string>
    <string name="settings_repeated_call_desc">Zenbaki berak blokeatu eta minutu gutxira berriro deitzen badu, bigarren deiak jotzen du. Zure agendan ez daudenen larrialdietarako da.</string>
    <string name="settings_history_enabled">Gorde blokeoen historia</string>
    <string name="settings_history_enabled_desc">Historia gailu honetan bakarrik geratzen da eta Sentinela-k zer blokeatu duen auditatzeko aukera ematen du. Desaktibatzeak ez du dagoeneko gordetakoa ezabatzen.</string>
    <string name="settings_history_off_kept">Historia desaktibatuta. Dagoeneko gordetako erregistroak gailuan jarraitzen dute.</string>
    <string name="settings_retention_title">Gorde erregistroak honenbeste denboraz</string>
    <string name="settings_retention_never">Ez gorde</string>
    <string name="settings_retention_7">7 egun</string>
    <string name="settings_retention_30">30 egun</string>
    <string name="settings_retention_90">90 egun</string>
    <string name="settings_retention_manual">Nik ezabatu arte</string>
    <string name="settings_retention_never_confirm">«Ez gorde» aukeratzeak lehendik dauden erregistroak ezabatzen ditu eta Sentinela-k blokeo berririk ez du erregistratzen. Ezin da desegin.</string>
    <plurals name="settings_clear_history_confirm">
        <item quantity="one">Honek blokeatutako deiaren %1$d erregistro ezabatzen du gailu honetatik. Ezin da desegin.</item>
