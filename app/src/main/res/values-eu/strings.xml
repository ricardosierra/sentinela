    <string name="action_back">Atzera</string>
    <string name="dialer_active_changes_title">Zer dagoen indarrean orain</string>
    <string name="dialer_activation_unavailable">Gailu honek ez du telefono lehenetsiaren rola eskaintzen — normalean telefoniarik ez duelako. Sentinela-ren iragazki moduak telefono-deiak dauden lekuan funtzionatzen jarraitzen du.</string>
    <string name="dialer_revert_cta">Aukeratu beste telefono bat</string>
    <string name="dialer_revert_hint">Beste telefono-aplikazio batera itzultzean, Sentinela-ren iragazki moduak normaltasunez funtzionatzen jarraitzen du — ezer berrinstalatu edo birkonfiguratu gabe.</string>

