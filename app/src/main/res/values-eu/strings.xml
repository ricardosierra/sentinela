    <!-- Markagailu moduaren aktibazioa -->
    <string name="dialer_activation_title">Sentinela zure telefono lehenetsi bihurtu?</string>
    <string name="dialer_activation_intro">Markagailu moduan, Sentinela-k dei guztiak jasotzen ditu — zure agendan daudenenak barne. Jatorriaren araberako politikak zure kontaktuei ere aplikatzeko modu bakarra da.</string>
    <string name="dialer_activation_changes_title">Zer aldatzen den</string>
    <string name="dialer_activation_change_1">Sentinela zure telefono-aplikazio bihurtzen da: dei-pantaila eta teklatua bereak izango dira.</string>
    <string name="dialer_activation_change_2">Iragazketak dei guztiak ikusten hasiko da, ez soilik agendatik kanpoko zenbakienak.</string>
    <string name="dialer_activation_change_3">Kontaktuentzat aukeratu duzun politika benetan aplikatzen da. Lehenetsia Jo izaten jarraitzen du — markagailu modua aktibatzeak, berez, ez du inor blokeatzen.</string>
    <string name="dialer_activation_unchanged_title">Zer ez den aldatzen</string>
    <string name="dialer_activation_unchanged_1">Deiak telefonoaren historian erregistratzen jarraitzen dute. Telefono-aplikazio lehenetsia izateak ez dio Sentinela-ri erregistro hori kentzeko baimenik ematen — Android-en, operadoreen aplikazioek bakarrik dezakete.</string>
    <string name="dialer_activation_unchanged_2">Sistemaren «Ez molestatu» moduak Sentinela-ren ezarpenen gainetik jarraitzen du.</string>
    <string name="dialer_activation_unchanged_3">WhatsApp, Telegram eta beste Interneteko aplikazioen deiak Sentinela-ren irismenetik kanpo jarraitzen dute.</string>
    <string name="dialer_activation_unchanged_4" formatted="false">Sentinela % 100 lineaz kanpokoa izaten jarraitzen du: ez dei, ez zenbaki, ez kontakturik ez da gailutik ateratzen.</string>
    <string name="dialer_activation_limit_calls">Dei bat aldi berean: zain dagoen deia eta konferentzia ez dira onartzen bertsio honetan.</string>
    <string name="dialer_activation_contacts_required">Markatze-moduak agenda irakurtzeko baimena behar du. Hori gabe, Sentinelak ezin ditu zure kontaktuak bereizi eta denak kontaktuetatik kanpoko gisa tratatuko lituzke.</string>
    <string name="dialer_activation_grant_contacts">Baimendu agenda irakurtzea</string>
    <string name="dialer_activation_cta">Aukeratu Sentinela</string>
    <string name="dialer_activation_cta_hint">Android-ek erabakitzen du. Nahi duzunean atzera egin dezakezu.</string>

