    <string name="settings_privacy_title">Soukromí</string>
    <string name="settings_privacy_disclaimer">Sentinela funguje 100% offline. Na rozdíl od jiných aplikací vaše kontakty neshromažďujeme ani je neposíláme do cloudu.</string>
    <string name="settings_mask_numbers">Maskovat příchozí čísla</string>
    <string name="settings_mask_numbers_desc">Skryje část čísel hvězdičkami (+55 11 9****-1234) v historii, v oznámeních a na domovské obrazovce.</string>

    <string name="settings_protection_toggle_desc">Vypnutá Sentinela neblokuje, neztlumuje a nic nezaznamenává. Hovory se chovají jako obvykle v telefonu.</string>
    <string name="settings_contacts_policy_note">Toto pravidlo platí, dokud je udělen přístup ke kontaktům. Bez něj kontakty spadají pod chybové pravidlo.</string>
    <string name="settings_block_mode_desc">Okamžité odmítnutí dá volajícímu obsazovací tón. Tiché přesměrování pošle hovor do hlasové schránky, pokud ji váš operátor nabízí.</string>
    <string name="settings_repeated_call">Druhý hovor v řadě vyzvání</string>
    <string name="settings_repeated_call_desc">Pokud stejné číslo zavolá znovu pár minut po zablokování, druhý hovor vyzvání. Slouží to pro naléhavé případy od lidí, které nemáte v seznamu kontaktů.</string>
    <string name="settings_history_enabled">Uchovávat historii blokování</string>
    <string name="settings_history_enabled_desc">Historie zůstává jen v tomto zařízení a je to ona, co umožňuje ověřit, co Sentinela zablokovala. Vypnutí nesmaže to, co už bylo uloženo.</string>
    <string name="settings_history_off_kept">Historie vypnutá. Již uložené záznamy zůstávají v zařízení.</string>
    <string name="settings_retention_title">Uchovávat záznamy po dobu</string>
    <string name="settings_retention_never">Neuchovávat</string>
    <string name="settings_retention_7">7 dní</string>
    <string name="settings_retention_30">30 dní</string>
    <string name="settings_retention_90">90 dní</string>
    <string name="settings_retention_manual">Dokud je nesmažu</string>
    <string name="settings_retention_never_confirm">Volba „Neuchovávat“ smaže stávající záznamy a Sentinela přestane zaznamenávat nová blokování. Nelze to vrátit zpět.</string>
    <plurals name="settings_clear_history_confirm">
        <item quantity="one">Tím se z tohoto zařízení smaže %1$d záznam o zablokovaném hovoru. Nelze to vrátit zpět.</item>
        <item quantity="few">Tím se z tohoto zařízení smažou %1$d záznamy o zablokovaných hovorech. Nelze to vrátit zpět.</item>
        <item quantity="many">Tím se z tohoto zařízení smaže %1$d záznamu o zablokovaných hovorech. Nelze to vrátit zpět.</item>
        <item quantity="other">Tím se z tohoto zařízení smaže %1$d záznamů o zablokovaných hovorech. Nelze to vrátit zpět.</item>
    </plurals>
    <string name="settings_fallback_desc">Pokud místní dotaz selže, musí se Sentinela rozhodnout sama. Povolení riskuje, že projde nechtěný hovor; blokování riskuje, že přijdete o hovor, který jste chtěli přijmout.</string>

