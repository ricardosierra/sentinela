    <!-- Uvedení do provozu: role filtrování hovorů -->
    <string name="onboarding_role_disclaimer">Nastavením udělujete oprávnění k filtrování hovorů. Sentinela filtruje hovory z neznámých čísel místně, aniž by kdy odeslala vaše data mimo zařízení.</string>
