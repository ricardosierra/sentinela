    <!-- Uvedení do provozu: kontakty -->
    <string name="contacts_title">A co lidé ve vašem seznamu kontaktů?</string>
    <string name="contacts_explainer">Určete, jak má Sentinela nakládat s hovory od lidí, které už znáte. Můžete to změnit později.</string>
    <string name="contacts_permission_rationale" formatted="false">Aby Sentinela věděla, jestli je volající ve vašem seznamu, musí přečíst vaše kontakty. Na rozdíl od jiných aplikací vaše kontakty neshromažďujeme. Čtení je 100% místní: data nikdy neopustí zařízení.</string>
    <string name="contacts_option_ring">Vyzvánět</string>
    <string name="contacts_option_ring_desc">Hovory ve vašem telefonu vyzvánějí jako obvykle.</string>
    <string name="contacts_option_block">Blokovat</string>
    <string name="contacts_option_block_desc">Blokuje všechny hovory podle režimu blokování v části Ochrana.</string>
    <string name="contacts_option_silence">Ztlumit</string>
    <string name="contacts_option_silence_desc">Telefon nevibruje ani nevyzvání, ale zobrazí oznámení.</string>
    <string name="contacts_option_never_silence">Nikdy neztlumovat</string>
    <string name="contacts_option_never_silence_desc">Sentinela nikdy neztlumí váš seznam kontaktů. Systémový režim „Nerušit“ nadále platí.</string>
    <string name="contacts_default_badge">Výchozí</string>

    <string name="whatsapp_contacts_warning_title">Upozornění k WhatsAppu</string>
    <string name="whatsapp_contacts_warning_desc">WhatsApp umožňuje ukládat kontakty jen do vlastního cloudu. Lidé uložení tímto způsobem v seznamu kontaktů zařízení neexistují a Sentinela je považuje za „Neznámé“. Uložte kontakty do oficiálního seznamu, aby je blokování rozpoznalo.</string>
    <string name="whatsapp_history_hint">Tip: pokud jde o kontakt z WhatsAppu, který není uložený v seznamu kontaktů, povolte ho volbou výše.</string>

    <string name="contacts_permission_granted">Přístup ke kontaktům udělen</string>
    <string name="contacts_permission_denied">Bez přístupu ke kontaktům nemůže Sentinela vědět, kdo je ve vašem seznamu: takové hovory mohou být považovány za neznámé.</string>
    <string name="contacts_permission_blocked">Přístup ke kontaktům byl trvale odepřen. Udělíte ho v nastavení aplikace.</string>
    <string name="settings_block_private_desc">Hovory bez identifikace čísla se řídí pravidlem blokování, které jste zvolili. Není možné zjistit, kdo volal.</string>

