    <string name="settings_dialer_mode">Režim telefonu (pokročilé)</string>
    <string name="settings_dialer_mode_desc">Udělá ze Sentinely výchozí aplikaci telefonu, aby se pravidla vztahovala i na kontakty. Kdykoli to můžete vrátit.</string>
    <string name="settings_mode_reject">Odmítnout ihned</string>
    <string name="settings_mode_silent_voicemail">Přesměrovat potichu</string>
    <string name="settings_hide_native_log">Požádat o nezaznamenání do historie telefonu</string>
    <string name="settings_hide_native_log_desc">Android této žádosti vyhoví jen u aplikací operátorů. Zablokované hovory se v historii hovorů telefonu nadále objevují, označené jako zablokované. Co blokování zaručuje: nezvoní, nevibruje, nezobrazí obrazovku hovoru a nevytvoří upozornění na zmeškaný hovor.</string>
