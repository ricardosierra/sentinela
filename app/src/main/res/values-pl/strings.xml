    <!-- Wdrożenie: kontakty -->
    <string name="contacts_title">A osoby z Twojej listy kontaktów?</string>
    <string name="contacts_explainer">Określ, jak Sentinela ma traktować połączenia od osób, które już znasz. Możesz to zmienić później.</string>
    <string name="contacts_permission_rationale" formatted="false">Aby wiedzieć, czy dzwoniący jest w Twojej książce, Sentinela musi odczytać Twoje kontakty. W odróżnieniu od innych aplikacji nie zbieramy Twoich kontaktów. Odczyt jest w 100% lokalny: dane nigdy nie opuszczają urządzenia.</string>
    <string name="contacts_option_ring">Dzwoń</string>
    <string name="contacts_option_ring_desc">Połączenia dzwonią normalnie w Twoim telefonie.</string>
    <string name="contacts_option_block">Blokuj</string>
    <string name="contacts_option_block_desc">Blokuje wszystkie połączenia zgodnie z trybem blokowania w sekcji Ochrona.</string>
    <string name="contacts_option_silence">Wycisz</string>
    <string name="contacts_option_silence_desc">Telefon nie wibruje ani nie dzwoni, ale pokazuje powiadomienie.</string>
    <string name="contacts_option_never_silence">Nigdy nie wyciszaj</string>
    <string name="contacts_option_never_silence_desc">Sentinela nigdy nie wycisza Twojej listy kontaktów. Systemowy tryb „Nie przeszkadzać” nadal obowiązuje.</string>
    <string name="contacts_default_badge">Domyślnie</string>

    <string name="whatsapp_contacts_warning_title">Uwaga o WhatsAppie</string>
    <string name="whatsapp_contacts_warning_desc">WhatsApp pozwala zapisywać kontakty wyłącznie we własnej chmurze. Osoby zapisane w ten sposób nie istnieją w książce adresowej urządzenia i dla Sentineli są traktowane jako „Nieznany”. Zapisz kontakty w oficjalnej książce adresowej, aby blokada je rozpoznawała.</string>
    <string name="whatsapp_history_hint">Wskazówka: jeśli to kontakt z WhatsAppa niezapisany w książce adresowej, użyj opcji powyżej, aby go dopuścić.</string>

    <string name="contacts_permission_granted">Dostęp do kontaktów przyznany</string>
    <string name="contacts_permission_denied">Bez dostępu do kontaktów Sentinela nie może wiedzieć, kto jest w Twojej książce: takie połączenia mogą być traktowane jako nieznane.</string>
    <string name="contacts_permission_blocked">Dostęp do kontaktów został trwale odrzucony. Aby go przyznać, otwórz ustawienia aplikacji.</string>
    <string name="settings_block_private_desc">Połączenia bez identyfikacji numeru podlegają wybranej przez Ciebie zasadzie blokowania. Nie da się ustalić, kto dzwonił.</string>

