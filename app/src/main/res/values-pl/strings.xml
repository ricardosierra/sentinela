    <!-- Włączenie trybu telefonu -->
    <string name="dialer_activation_title">Uczynić Sentinelę Twoim domyślnym telefonem?</string>
    <string name="dialer_activation_intro">W trybie telefonu Sentinela odbiera wszystkie połączenia — także od osób z Twojej książki adresowej. To jedyny sposób, by zasady według źródła obowiązywały również Twoje kontakty.</string>
    <string name="dialer_activation_changes_title">Co się zmienia</string>
    <string name="dialer_activation_change_1">Sentinela staje się Twoją aplikacją telefonu: ekran połączenia i klawiatura stają się jej własne.</string>
    <string name="dialer_activation_change_2">Filtrowanie zaczyna widzieć wszystkie połączenia, nie tylko te z numerów spoza książki adresowej.</string>
    <string name="dialer_activation_change_3">Zasada wybrana dla kontaktów jest naprawdę stosowana. Wartość domyślna to nadal Dzwoń — samo włączenie trybu telefonu nikogo nie blokuje.</string>
    <string name="dialer_activation_unchanged_title">Co się nie zmienia</string>
    <string name="dialer_activation_unchanged_1">Połączenia nadal są zapisywane w historii połączeń telefonu. Bycie domyślną aplikacją telefonu nie daje Sentineli prawa do pominięcia tego wpisu — w Androidzie mogą to tylko aplikacje operatorów.</string>
    <string name="dialer_activation_unchanged_2">Systemowy tryb „Nie przeszkadzać” ma nadal pierwszeństwo przed ustawieniami Sentineli.</string>
    <string name="dialer_activation_unchanged_3">Połączenia z WhatsAppa, Telegrama i innych aplikacji internetowych pozostają poza zasięgiem Sentineli.</string>
    <string name="dialer_activation_unchanged_4" formatted="false">Sentinela pozostaje w 100% offline: żadne połączenie, numer ani kontakt nie opuszcza urządzenia.</string>
    <string name="dialer_activation_limit_calls">Jedno połączenie naraz: połączenie oczekujące i konferencja nie są obsługiwane w tej wersji.</string>
    <string name="dialer_activation_contacts_required">Tryb telefonu wymaga uprawnienia do odczytu kontaktów. Bez niego Sentinela nie odróżni Twoich kontaktów i zaczęłaby traktować wszystkich jako nieznanych.</string>
    <string name="dialer_activation_grant_contacts">Zezwól na odczyt kontaktów</string>
    <string name="dialer_activation_cta">Wybierz Sentinelę</string>
    <string name="dialer_activation_cta_hint">Decyduje Android. Możesz wrócić, kiedy zechcesz.</string>

