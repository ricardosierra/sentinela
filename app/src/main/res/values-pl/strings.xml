    <!-- Wdrożenie: rola filtrowania połączeń -->
    <string name="onboarding_role_disclaimer">Konfigurując, przyznajesz uprawnienie do filtrowania połączeń. Sentinela filtruje połączenia z nieznanych numerów lokalnie, nigdy nie wysyłając Twoich danych poza urządzenie.</string>
    <string name="onboarding_role_cta">Skonfiguruj teraz</string>
    <string name="onboarding_role_requesting">Prośba o uprawnienie…</string>
    <string name="onboarding_step_indicator">Krok %1$d z %2$d</string>
    <string name="onboarding_next">Dalej</string>
    <string name="onboarding_back">Wstecz</string>
    <string name="onboarding_finish">Zakończ konfigurację</string>
    <string name="onboarding_change_later">To ustawienie możesz zmienić w dowolnej chwili.</string>
    <string name="onboarding_skip">Pomiń</string>
    <string name="onboarding_role_title">Niech Sentinela zajmie się filtrowaniem</string>
    <string name="onboarding_role_intro">Aby filtrować połączenia, Sentinela musi być domyślną aplikacją do filtrowania połączeń w Androidzie. To Ty przyznajesz uprawnienie i możesz je cofnąć w ustawieniach systemu, kiedy zechcesz.</string>
    <string name="onboarding_role_denied">Sentinela nie otrzymała roli filtrowania połączeń. Żadne połączenie nie będzie filtrowane, dopóki nie przyznasz uprawnienia — możesz to zrobić teraz lub później, na ekranie Ochrona.</string>
    <string name="onboarding_role_retry">Przyznaj teraz</string>
    <string name="onboarding_scope_title">Czego Sentinela nie robi</string>
    <string name="onboarding_scope_dnd">Systemowy tryb „Nie przeszkadzać” ma nadal pierwszeństwo przed ustawieniami Sentineli.</string>

    <!-- Wdrożenie: nieznane numery -->
