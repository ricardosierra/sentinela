    <string name="settings_block_private">Blokuj numery prywatne</string>
    <string name="settings_dialer_mode">Tryb telefonu (zaawansowane)</string>
    <string name="settings_dialer_mode_desc">Czyni Sentinelę domyślną aplikacją telefonu, aby zasady dotyczyły także kontaktów. Możesz to cofnąć w dowolnej chwili.</string>
    <string name="settings_mode_reject">Odrzucaj natychmiast</string>
    <string name="settings_mode_silent_voicemail">Przekieruj po cichu</string>
    <string name="settings_hide_native_log">Poproś o nierejestrowanie w historii telefonu</string>
    <string name="settings_hide_native_log_desc">Android spełnia tę prośbę tylko dla aplikacji operatorów. Zablokowane połączenia nadal pojawiają się w historii połączeń telefonu, oznaczone jako zablokowane. Co gwarantuje blokada: nie dzwoni, nie wibruje, nie pokazuje ekranu połączenia i nie tworzy powiadomienia o nieodebranym połączeniu.</string>
    <string name="settings_show_notification">Pokaż ciche powiadomienie</string>
    <string name="settings_fallback_policy">Co zrobić w razie awarii</string>
    <string name="settings_fallback_allow">Pozwól połączeniu zadzwonić</string>
    <string name="settings_fallback_block">Blokuj</string>

    <string name="settings_privacy_title">Prywatność</string>
    <string name="settings_privacy_disclaimer">Sentinela działa w 100% offline. W odróżnieniu od innych aplikacji nie zbieramy Twoich kontaktów ani nie wysyłamy ich do chmury.</string>
    <string name="settings_mask_numbers">Maskuj numery przychodzące</string>
    <string name="settings_mask_numbers_desc">Ukrywa część numerów gwiazdkami (+55 11 9****-1234) w historii, w powiadomieniach i na ekranie głównym.</string>

    <string name="settings_protection_toggle_desc">Wyłączona Sentinela nie blokuje, nie wycisza i niczego nie zapisuje. Połączenia zachowują się jak zwykle w telefonie.</string>
    <string name="settings_contacts_policy_note">Ta zasada obowiązuje, dopóki dostęp do kontaktów jest przyznany. Bez niego kontakty podlegają zasadzie awaryjnej.</string>
    <string name="settings_block_mode_desc">Odrzucanie natychmiast daje dzwoniącemu sygnał zajętości. Przekierowanie po cichu wysyła połączenie na pocztę głosową, jeśli Twój operator ma tę usługę.</string>
    <string name="settings_repeated_call">Drugie połączenie z rzędu dzwoni</string>
    <string name="settings_repeated_call_desc">Jeśli ten sam numer zadzwoni ponownie kilka minut po zablokowaniu, drugie połączenie zadzwoni. Służy to nagłym przypadkom od osób spoza Twojej książki adresowej.</string>
    <string name="settings_history_enabled">Zachowuj historię blokad</string>
    <string name="settings_history_enabled_desc">Historia zostaje tylko na tym urządzeniu i to ona pozwala sprawdzić, co Sentinela zablokowała. Wyłączenie nie usuwa tego, co już zapisano.</string>
    <string name="settings_history_off_kept">Historia wyłączona. Już zapisane wpisy pozostają na urządzeniu.</string>
    <string name="settings_retention_title">Przechowuj wpisy przez</string>
    <string name="settings_retention_never">Nie przechowuj</string>
    <string name="settings_retention_7">7 dni</string>
    <string name="settings_retention_30">30 dni</string>
    <string name="settings_retention_90">90 dni</string>
    <string name="settings_retention_manual">Dopóki ich nie usunę</string>
    <string name="settings_retention_never_confirm">Wybranie opcji „Nie przechowuj” usuwa istniejące wpisy, a Sentinela przestaje zapisywać nowe blokady. Nie można tego cofnąć.</string>
    <plurals name="settings_clear_history_confirm">
        <item quantity="one">Spowoduje to usunięcie %1$d wpisu o zablokowanym połączeniu z tego urządzenia. Nie można tego cofnąć.</item>
        <item quantity="few">Spowoduje to usunięcie %1$d wpisów o zablokowanych połączeniach z tego urządzenia. Nie można tego cofnąć.</item>
        <item quantity="many">Spowoduje to usunięcie %1$d wpisów o zablokowanych połączeniach z tego urządzenia. Nie można tego cofnąć.</item>
        <item quantity="other">Spowoduje to usunięcie %1$d wpisu o zablokowanych połączeniach z tego urządzenia. Nie można tego cofnąć.</item>
    </plurals>
    <string name="settings_fallback_desc">Jeśli zapytanie lokalne się nie powiedzie, Sentinela musi zdecydować sama. Zezwolenie grozi przepuszczeniem niechcianego połączenia; blokada grozi utratą połączenia, które chciałeś odebrać.</string>

