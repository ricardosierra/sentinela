    <string name="settings_block_private">Blokér private numre</string>
    <string name="settings_dialer_mode">Opkaldstilstand (avanceret)</string>
    <string name="settings_dialer_mode_desc">Gør Sentinela til standardtelefonappen, så politikkerne også gælder for kontakter. Du kan fortryde når som helst.</string>
    <string name="settings_mode_reject">Afvis med det samme</string>
    <string name="settings_mode_silent_voicemail">Viderestil lydløst</string>
    <string name="settings_hide_native_log">Bed om ikke at blive registreret i telefonens historik</string>
    <string name="settings_hide_native_log_desc">Android imødekommer kun den anmodning for teleselskabers apps. Blokerede opkald bliver ved med at stå i telefonens opkaldshistorik, markeret som blokerede. Det, blokeringen garanterer: den ringer ikke, vibrerer ikke, viser ikke opkaldsskærmen og giver ingen besked om ubesvaret opkald.</string>
    <string name="settings_show_notification">Vis lydløs notifikation</string>
    <string name="settings_fallback_policy">Hvad der skal ske ved fejl</string>
    <string name="settings_fallback_allow">Lad opkaldet ringe</string>
    <string name="settings_fallback_block">Blokér</string>

    <string name="settings_privacy_title">Privatliv</string>
    <string name="settings_privacy_disclaimer">Sentinela er 100% offline. I modsætning til andre apps indsamler vi ikke dine kontakter og sender dem ikke til skyen.</string>
    <string name="settings_mask_numbers">Maskér indgående numre</string>
    <string name="settings_mask_numbers_desc">Skjuler en del af numrene med stjerner (+55 11 9****-1234) i historikken, i notifikationer og på startskærmen.</string>

    <string name="settings_protection_toggle_desc">Når den er slået fra, blokerer Sentinela ikke, dæmper ikke og registrerer ingenting. Opkald følger telefonens normale adfærd.</string>
    <string name="settings_contacts_policy_note">Denne politik gælder, så længe adgang til kontakter er givet. Uden den falder kontakter ind under fejlpolitikken.</string>
    <string name="settings_block_mode_desc">Afvis med det samme giver den, der ringer, optagettone. Viderestil lydløst sender opkaldet til telefonsvareren, hvis dit teleselskab har den tjeneste.</string>
    <string name="settings_repeated_call">Andet opkald i træk ringer</string>
    <string name="settings_repeated_call_desc">Hvis det samme nummer ringer igen få minutter efter at være blevet blokeret, ringer det andet opkald. Det er til nødsituationer fra folk, der ikke står i din adressebog.</string>
    <string name="settings_history_enabled">Gem blokeringshistorik</string>
    <string name="settings_history_enabled_desc">Historikken bliver kun på denne enhed og er det, der gør det muligt at efterprøve, hvad Sentinela har blokeret. At slå den fra sletter ikke det, der allerede er gemt.</string>
    <string name="settings_history_off_kept">Historik slået fra. De allerede gemte poster bliver på enheden.</string>
    <string name="settings_retention_title">Gem poster i</string>
    <string name="settings_retention_never">Gem ikke</string>
    <string name="settings_retention_7">7 dage</string>
    <string name="settings_retention_30">30 dage</string>
    <string name="settings_retention_90">90 dage</string>
    <string name="settings_retention_manual">Indtil jeg sletter dem</string>
    <string name="settings_retention_never_confirm">Vælger du \"Gem ikke\", slettes de eksisterende poster, og Sentinela holder op med at registrere nye blokeringer. Det kan ikke fortrydes.</string>
    <plurals name="settings_clear_history_confirm">
        <item quantity="one">Dette sletter %1$d post om et blokeret opkald fra denne enhed. Det kan ikke fortrydes.</item>
        <item quantity="other">Dette sletter %1$d poster om blokerede opkald fra denne enhed. Det kan ikke fortrydes.</item>
    </plurals>
    <string name="settings_fallback_desc">Hvis det lokale opslag mislykkes, må Sentinela bestemme selv. At tillade risikerer at lade et uønsket opkald slippe igennem; at blokere risikerer at gå glip af et opkald, du gerne ville modtage.</string>

