    <!-- Opsætning: rollen som opkaldsfilter -->
    <string name="onboarding_role_disclaimer">Ved opsætning giver du tilladelse til Call Screening. Sentinela filtrerer opkald fra numre uden for dine kontakter lokalt uden nogensinde at sende data væk fra enheden.</string>
    <string name="onboarding_role_cta">Sæt op nu</string>
    <string name="onboarding_role_requesting">Anmoder om tilladelse…</string>
    <string name="onboarding_step_indicator">Trin %1$d af %2$d</string>
    <string name="onboarding_next">Næste</string>
    <string name="onboarding_back">Tilbage</string>
    <string name="onboarding_finish">Afslut opsætningen</string>
    <string name="onboarding_change_later">Du kan ændre denne indstilling når som helst.</string>
    <string name="onboarding_skip">Spring over</string>
    <string name="onboarding_role_title">Lad Sentinela stå for filtreringen</string>
    <string name="onboarding_role_intro">For at filtrere opkald skal Sentinela være Androids standardapp til opkaldsfiltrering. Det er dig, der giver tilladelsen, og du kan fortryde den i systemindstillingerne, når du vil.</string>
    <string name="onboarding_role_denied">Sentinela fik ikke rollen som opkaldsfilter. Ingen opkald bliver filtreret, før du giver tilladelsen — du kan gøre det nu eller senere på skærmen Beskyttelse.</string>
    <string name="onboarding_role_retry">Giv tilladelse nu</string>
    <string name="onboarding_scope_title">Det gør Sentinela ikke</string>
    <string name="onboarding_scope_dnd">Systemets \"Forstyr ikke\" gælder stadig frem for Sentinelas indstillinger.</string>

    <!-- Opsætning: ukendte numre -->
    <string name="unknown_title">Numre uden for kontakter</string>
    <string name="unknown_question">Hvordan skal Sentinela håndtere numre, der ikke er i dine kontakter?</string>
    <string name="unknown_option_block">Blokér</string>
