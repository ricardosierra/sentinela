    <!-- Opsætning: kontakter -->
    <string name="contacts_title">Og personerne på din kontaktliste?</string>
    <string name="contacts_explainer">Bestem, hvordan Sentinela skal behandle opkald fra dem, du allerede kender. Du kan ændre det senere.</string>
    <string name="contacts_permission_rationale" formatted="false">For at vide, om den, der ringer, står i din adressebog, skal Sentinela læse dine kontakter. I modsætning til andre apps indsamler vi ikke dine kontakter. Læsningen er 100% lokal: dataene forlader aldrig enheden.</string>
    <string name="contacts_option_ring">Ring</string>
    <string name="contacts_option_ring_desc">Opkald ringer som normalt på din telefon.</string>
    <string name="contacts_option_block">Blokér</string>
    <string name="contacts_option_block_desc">Blokerer alle opkald efter blokeringstilstanden under Beskyttelse.</string>
    <string name="contacts_option_silence">Sæt på lydløs</string>
    <string name="contacts_option_silence_desc">Telefonen vibrerer ikke og ringer ikke, men viser notifikationen.</string>
    <string name="contacts_option_never_silence">Sæt aldrig på lydløs</string>
    <string name="contacts_option_never_silence_desc">Sentinela sætter aldrig din kontaktliste på lydløs. Systemets \"Forstyr ikke\" gælder stadig.</string>
    <string name="contacts_default_badge">Standard</string>

    <string name="whatsapp_contacts_warning_title">Bemærk om WhatsApp</string>
    <string name="whatsapp_contacts_warning_desc">WhatsApp giver mulighed for kun at gemme kontakter i sin sky. Personer, der er gemt på denne måde, findes ikke i enhedens adressebog og vil for Sentinela blive behandlet som \"Uden for kontakter\". Gem dine kontakter i den officielle adressebog, så blokeringen genkender dem.</string>
    <string name="whatsapp_history_hint">Tip: Hvis det er en WhatsApp-kontakt, der ikke er gemt i adressebogen, kan du bruge muligheden ovenfor til at tillade den.</string>

    <string name="contacts_permission_granted">Adgang til kontakter givet</string>
    <string name="contacts_permission_denied">Uden adgang til adressebogen kan Sentinela ikke vide, hvem der er i dine kontakter: disse opkald kan blive behandlet som numre uden for kontakter.</string>
    <string name="contacts_permission_blocked">Adgang til kontakter er afvist permanent. Åbn appens indstillinger for at give den.</string>
    <string name="settings_block_private_desc">Opkald uden nummervisning følger den blokeringspolitik, du har valgt. Det er ikke muligt at se, hvem der ringede.</string>

