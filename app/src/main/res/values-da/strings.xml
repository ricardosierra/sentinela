    <!-- Beskyttelse / Indstillinger -->
    <string name="settings_title">Beskyttelse</string>
    <string name="settings_protection_toggle">Slå beskyttelse til</string>
    <string name="settings_unknown_policy">Numre uden for kontakter</string>
