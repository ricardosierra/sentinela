    <!-- Aktivering af opkaldstilstand -->
    <string name="dialer_activation_title">Vil du gøre Sentinela til din standardtelefon?</string>
    <string name="dialer_activation_intro">I opkaldstilstand modtager Sentinela alle opkald — også fra dem, der står i din adressebog. Det er den eneste måde, hvorpå politikkerne pr. kilde også gælder for dine kontakter.</string>
    <string name="dialer_activation_changes_title">Det ændrer sig</string>
    <string name="dialer_activation_change_1">Sentinela bliver din telefonapp: opkaldsskærmen og tastaturet bliver appens egne.</string>
    <string name="dialer_activation_change_2">Filtreringen begynder at se alle opkald, ikke kun dem fra numre uden for adressebogen.</string>
    <string name="dialer_activation_change_3">Den politik, du valgte for kontakter, bliver reelt anvendt. Standarden er stadig Ring — at slå opkaldstilstand til blokerer i sig selv ingen.</string>
    <string name="dialer_activation_unchanged_title">Det ændrer sig ikke</string>
    <string name="dialer_activation_unchanged_1">Opkald bliver stadig registreret i telefonens opkaldshistorik. At være standardtelefonappen giver ikke Sentinela tilladelse til at udelade den registrering — på Android kan kun teleselskabers apps det.</string>
    <string name="dialer_activation_unchanged_2">Systemets \"Forstyr ikke\" gælder stadig frem for Sentinelas indstillinger.</string>
    <string name="dialer_activation_unchanged_3">Opkald fra WhatsApp, Telegram og andre internetapps er stadig uden for Sentinelas rækkevidde.</string>
    <string name="dialer_activation_unchanged_4" formatted="false">Sentinela forbliver 100% offline: intet opkald, nummer eller kontakt forlader enheden.</string>
    <string name="dialer_activation_limit_calls">Ét opkald ad gangen: banke på og telefonmøde understøttes ikke i denne version.</string>
    <string name="dialer_activation_contacts_required">Opkaldstilstand kræver tilladelse til at læse adressebogen. Uden den kan Sentinela ikke kende forskel på dine kontakter og ville behandle alle som uden for kontakter.</string>
    <string name="dialer_activation_grant_contacts">Tillad adgang til kontakter</string>
    <string name="dialer_activation_cta">Vælg Sentinela</string>
    <string name="dialer_activation_cta_hint">Det er Android, der bestemmer. Du kan gå tilbage, når du vil.</string>

