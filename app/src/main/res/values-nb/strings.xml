    <!-- Oppsett: kontakter -->
    <string name="contacts_title">Og personene i kontaktlisten din?</string>
    <string name="contacts_explainer">Bestem hvordan Sentinela skal behandle anrop fra dem du allerede kjenner. Du kan endre det senere.</string>
    <string name="contacts_permission_rationale" formatted="false">For å vite om den som ringer står i adresseboken din, må Sentinela lese kontaktene dine. I motsetning til andre apper samler vi ikke inn kontaktene dine. Lesingen er 100% lokal: dataene forlater aldri enheten.</string>
    <string name="contacts_option_ring">Ring</string>
    <string name="contacts_option_ring_desc">Anropene ringer som vanlig på telefonen din.</string>
    <string name="contacts_option_block">Blokker</string>
    <string name="contacts_option_block_desc">Blokkerer alle anrop, i tråd med blokkeringsmodusen under Beskyttelse.</string>
    <string name="contacts_option_silence">Demp</string>
    <string name="contacts_option_silence_desc">Telefonen verken vibrerer eller ringer, men viser varselet.</string>
    <string name="contacts_option_never_silence">Demp aldri</string>
    <string name="contacts_option_never_silence_desc">Sentinela demper aldri kontaktlisten din. Systemets \"Ikke forstyrr\" gjelder fortsatt.</string>
    <string name="contacts_default_badge">Standard</string>

    <string name="whatsapp_contacts_warning_title">Om WhatsApp</string>
    <string name="whatsapp_contacts_warning_desc">WhatsApp lar deg bare lagre kontakter i sin egen sky. Personer som er lagret slik, finnes ikke i adresseboken på enheten, og Sentinela behandler dem som \"Ukjent\". Lagre kontaktene dine i den offisielle adresseboken slik at blokkereren gjenkjenner dem.</string>
    <string name="whatsapp_history_hint">Tips: hvis dette er en WhatsApp-kontakt som ikke er lagret i adresseboken, kan du bruke valget over for å tillate den.</string>

    <string name="contacts_permission_granted">Tilgang til kontakter gitt</string>
    <string name="contacts_permission_denied">Uten tilgang til kontakter kan ikke Sentinela vite hvem som står i adresseboken din: de anropene kan bli behandlet som ukjente.</string>
    <string name="contacts_permission_blocked">Tilgangen til kontakter ble avslått permanent. Åpne appinnstillingene for å gi den.</string>
    <string name="settings_block_private_desc">Anrop uten nummervisning følger blokkeringsregelen du har valgt. Det er ikke mulig å vite hvem som ringte.</string>

