    <string name="settings_hide_native_log">Be om å ikke bli registrert i anropsloggen</string>
    <string name="settings_hide_native_log_desc">Android etterkommer bare den forespørselen for apper fra teleoperatører. Blokkerte anrop står fortsatt i anropsloggen på telefonen, merket som blokkerte. Det blokkeringen garanterer: den ringer ikke, vibrerer ikke, viser ingen anropsskjerm og gir ingen varsel om tapt anrop.</string>
