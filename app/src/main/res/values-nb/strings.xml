    <string name="settings_privacy_title">Personvern</string>
    <string name="settings_privacy_disclaimer">Sentinela er 100%% frakoblet. I motsetning til andre apper samler vi ikke inn kontaktene dine og sender dem ikke til skyen.</string>
    <string name="settings_mask_numbers">Masker innkommende numre</string>
    <string name="settings_mask_numbers_desc">Skjuler deler av numrene med stjerner (+55 11 9****-1234) i historikken, i varsler og på startskjermen.</string>

    <string name="settings_protection_toggle_desc">Når den er av, blokkerer ikke Sentinela, demper ikke og registrerer ingenting. Anropene følger telefonens vanlige oppførsel.</string>
    <string name="settings_contacts_policy_note">Denne regelen gjelder så lenge tilgangen til kontakter er gitt. Uten den faller kontakter inn under feilregelen.</string>
    <string name="settings_block_mode_desc">Avvis umiddelbart gir opptattsignal til den som ringer. Viderekoble stille sender anropet til telefonsvareren, hvis operatøren din har den tjenesten.</string>
    <string name="settings_repeated_call">Andre anrop på rad ringer</string>
    <string name="settings_repeated_call_desc">Hvis det samme nummeret ringer igjen få minutter etter å ha blitt blokkert, ringer det andre anropet. Det er ment for nødsituasjoner fra folk som ikke står i adresseboken din.</string>
    <string name="settings_history_enabled">Lagre blokkeringshistorikk</string>
    <string name="settings_history_enabled_desc">Historikken blir bare på denne enheten og er det som gjør det mulig å etterprøve hva Sentinela har blokkert. Å slå den av sletter ikke det som allerede er lagret.</string>
    <string name="settings_history_off_kept">Historikk slått av. Oppføringene som allerede er lagret, blir liggende på enheten.</string>
    <string name="settings_retention_title">Lagre oppføringer i</string>
    <string name="settings_retention_never">Ikke lagre</string>
    <string name="settings_retention_7">7 dager</string>
    <string name="settings_retention_30">30 dager</string>
    <string name="settings_retention_90">90 dager</string>
    <string name="settings_retention_manual">Til jeg sletter dem</string>
    <string name="settings_retention_never_confirm">Å velge \"Ikke lagre\" sletter de eksisterende oppføringene, og Sentinela slutter å registrere nye blokkeringer. Det kan ikke angres.</string>
    <plurals name="settings_clear_history_confirm">
        <item quantity="one">Dette sletter %1$d oppføring om blokkert anrop fra denne enheten. Det kan ikke angres.</item>
        <item quantity="other">Dette sletter %1$d oppføringer om blokkerte anrop fra denne enheten. Det kan ikke angres.</item>
    </plurals>
    <string name="settings_fallback_desc">Hvis det lokale oppslaget mislykkes, må Sentinela bestemme selv. Å tillate risikerer å slippe gjennom et uønsket anrop; å blokkere risikerer at du går glipp av et anrop du ville ha.</string>

