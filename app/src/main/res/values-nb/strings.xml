    <!-- Aktivering av oppringingsmodus -->
    <string name="dialer_activation_title">Vil du gjøre Sentinela til standardtelefonen din?</string>
    <string name="dialer_activation_intro">I oppringingsmodus mottar Sentinela alle anrop — også fra dem som står i adresseboken din. Det er den eneste måten reglene per kilde også gjelder for kontaktene dine.</string>
    <string name="dialer_activation_changes_title">Dette endrer seg</string>
    <string name="dialer_activation_change_1">Sentinela blir telefonappen din: anropsskjermen og tastaturet blir appens egne.</string>
    <string name="dialer_activation_change_2">Filtreringen begynner å se alle anrop, ikke bare dem fra numre utenfor adresseboken.</string>
    <string name="dialer_activation_change_3">Regelen du valgte for kontakter, blir faktisk brukt. Standardvalget er fortsatt Ring — å slå på oppringingsmodus blokkerer i seg selv ingen.</string>
    <string name="dialer_activation_unchanged_title">Dette endrer seg ikke</string>
    <string name="dialer_activation_unchanged_1">Anropene blir fortsatt registrert i anropsloggen på telefonen. Å være standard telefonapp gir ikke Sentinela tillatelse til å utelate den registreringen — på Android kan bare apper fra teleoperatører gjøre det.</string>
    <string name="dialer_activation_unchanged_2">Systemets \"Ikke forstyrr\" gjelder fortsatt foran innstillingene i Sentinela.</string>
    <string name="dialer_activation_unchanged_3">Anrop fra WhatsApp, Telegram og andre internettapper er fortsatt utenfor Sentinelas rekkevidde.</string>
    <string name="dialer_activation_unchanged_4" formatted="false">Sentinela forblir 100% frakoblet: ingen anrop, numre eller kontakter forlater enheten.</string>
    <string name="dialer_activation_limit_calls">Ett anrop om gangen: samtale venter og konferansesamtale støttes ikke i denne versjonen.</string>
    <string name="dialer_activation_contacts_required">Oppringingsmodus trenger tillatelse til å lese kontakter. Uten den kan ikke Sentinela skille ut kontaktene dine og ville begynt å behandle alle som ukjente.</string>
    <string name="dialer_activation_grant_contacts">Tillat tilgang til kontakter</string>
    <string name="dialer_activation_cta">Velg Sentinela</string>
    <string name="dialer_activation_cta_hint">Det er Android som bestemmer. Du kan gå tilbake når du vil.</string>

