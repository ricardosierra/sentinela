    <string name="settings_privacy_title">Privacidade</string>
    <string name="settings_privacy_disclaimer">O Sentinela é 100% offline. Ao contrário de outras aplicações, não recolhemos os seus contactos nem os enviamos para a nuvem.</string>
    <string name="settings_mask_numbers">Mascarar números recebidos</string>
    <string name="settings_mask_numbers_desc">Oculta parte dos números com asteriscos (+55 11 9****-1234) no histórico, nas notificações e no ecrã inicial.</string>

    <string name="settings_protection_toggle_desc">Desligado, o Sentinela não bloqueia, não silencia e não regista nada. As chamadas seguem o comportamento normal do telemóvel.</string>
    <string name="settings_contacts_policy_note">Esta política vale enquanto a leitura dos contactos estiver concedida. Sem ela, os contactos caem na política de erro.</string>
    <string name="settings_block_mode_desc">Rejeitar de imediato dá sinal de ocupado a quem liga. Encaminhar silenciosamente envia a chamada para o correio de voz, se a sua operadora tiver esse serviço.</string>
    <string name="settings_repeated_call">Segunda chamada seguida toca</string>
    <string name="settings_repeated_call_desc">Se o mesmo número voltar a ligar poucos minutos depois de ser bloqueado, a segunda chamada toca. Serve para emergências de quem não está nos seus contactos.</string>
    <string name="settings_history_enabled">Guardar histórico de bloqueios</string>
    <string name="settings_history_enabled_desc">O histórico fica só neste dispositivo e é o que permite auditar o que o Sentinela bloqueou. Desligar não apaga o que já foi guardado.</string>
    <string name="settings_history_off_kept">Histórico desligado. Os registos já guardados continuam no dispositivo.</string>
    <string name="settings_retention_title">Guardar registos durante</string>
    <string name="settings_retention_never">Não guardar</string>
    <string name="settings_retention_7">7 dias</string>
    <string name="settings_retention_30">30 dias</string>
    <string name="settings_retention_90">90 dias</string>
    <string name="settings_retention_manual">Até eu eliminar</string>
    <string name="settings_retention_never_confirm">Escolher \"Não guardar\" apaga os registos existentes e o Sentinela deixa de registar novos bloqueios. Não é possível anular.</string>
    <plurals name="settings_clear_history_confirm">
        <item quantity="one">Isto apaga %1$d registo de chamada bloqueada deste dispositivo. Não é possível anular.</item>
        <item quantity="other">Isto apaga %1$d registos de chamadas bloqueadas deste dispositivo. Não é possível anular.</item>
