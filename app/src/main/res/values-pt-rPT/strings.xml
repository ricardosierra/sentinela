    <!-- Onboarding: contactos -->
    <string name="contacts_title">E as pessoas da sua lista de contactos?</string>
    <string name="contacts_explainer">Defina como o Sentinela deve tratar as chamadas de quem já conhece. Pode alterar isto mais tarde.</string>
    <string name="contacts_permission_rationale" formatted="false">Para saber se quem liga está na sua lista, o Sentinela precisa de ler os seus contactos. Ao contrário de outras aplicações, não recolhemos os seus contactos. A leitura é 100% local: os dados nunca saem do dispositivo.</string>
    <string name="contacts_option_ring">Tocar</string>
    <string name="contacts_option_ring_desc">As chamadas tocam normalmente no seu telemóvel.</string>
    <string name="contacts_option_block">Bloquear</string>
    <string name="contacts_option_block_desc">Bloqueia todas as chamadas, conforme o modo de bloqueio em Proteção.</string>
    <string name="contacts_option_silence">Silenciar</string>
    <string name="contacts_option_silence_desc">O telemóvel não vibra nem toca, mas mostra a notificação.</string>
    <string name="contacts_option_never_silence">Nunca silenciar</string>
    <string name="contacts_option_never_silence_desc">O Sentinela nunca silencia a sua lista de contactos. O \"Não incomodar\" do sistema continua a prevalecer.</string>
    <string name="contacts_default_badge">Predefinição</string>

    <string name="whatsapp_contacts_warning_title">Aviso sobre o WhatsApp</string>
    <string name="whatsapp_contacts_warning_desc">O WhatsApp permite guardar contactos apenas na nuvem dele. As pessoas guardadas assim não existem na lista de contactos do dispositivo e, para o Sentinela, são tratadas como \"Desconhecido\". Guarde os seus contactos na lista oficial para que o bloqueador os reconheça.</string>
    <string name="whatsapp_history_hint">Sugestão: se for um contacto do WhatsApp não guardado na lista, use a opção acima para permitir.</string>

    <string name="contacts_permission_granted">Leitura dos contactos concedida</string>
    <string name="contacts_permission_denied">Sem a leitura dos contactos, o Sentinela não consegue saber quem está na sua lista: essas chamadas podem ser tratadas como desconhecidas.</string>
    <string name="contacts_permission_blocked">A leitura dos contactos foi recusada definitivamente. Para conceder, abra as definições da aplicação.</string>
    <string name="settings_block_private_desc">As chamadas sem identificação de número seguem a política de bloqueio que escolheu. Não é possível saber quem ligou.</string>

